---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, phoneDisplay, phoneHref, travelContact, whatsappUrl } from '../data/business';
const title = "Request an Estimate | Nora's Upholstery";
const description = "Send photos and details for an upholstery estimate across the Greater Toronto Area.";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const formMessages: Record<string, string> = {
  missing: 'Please complete every required field.',
  invalid: 'Please check your email address and phone number.',
  files: 'Choose up to 5 valid JPG, PNG, WebP, HEIC or HEIF photos, each under 5 MB.',
  large: 'The upload is too large. Choose up to 5 photos under 5 MB each.',
  verification: 'Please complete the security check and try again.',
  unavailable: 'The contact form is temporarily unavailable. Please call, email or message us on WhatsApp.',
  send: 'We could not send your request. Please try again or use one of the contact options.',
};
const formWasSent = Astro.url.searchParams.get('sent') === '1';
const formError = Astro.url.searchParams.get('error') || '';
const initialFormStatus = formMessages[formError] || '';
---
<BaseLayout {title} {description}>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <header class="page-hero contact-page-hero">
    <div class="shell contact-page-hero__inner">
      <div>
        <p class="eyebrow">Choose what works for you</p>
        <h1>Let’s talk about<br /><em>your project.</em></h1>
        <p>Call, email, message us on WhatsApp or use the contact form—whichever is most convenient. Photos are helpful, but not required to get started.</p>
        {travelContact.enabled && (
          <div class="travel-contact-card glass">
            <strong>{travelContact.notice}</strong>
            <a href={whatsappUrl} target="_blank" rel="noopener">Message us on WhatsApp <span>↗</span></a>
            <a href={`mailto:${business.email}`}>Email us <span>↗</span></a>
          </div>
        )}
      </div>
    </div>
  </header>

  <section class="content-section contact-content">
    <div class="shell form-shell contact-form-shell">
      <aside class="contact-side">
        <p class="eyebrow">Contact options</p>
        <h2 class="contact-heading">Reach us <em>directly.</em></h2>
        <div class="contact-list">
          <a href={phoneHref}><small>Call</small><span>{phoneDisplay}</span></a>
          <a href={`mailto:${business.email}`}><small>Email</small><span>{business.email}</span></a>
          <a href={whatsappUrl} target="_blank" rel="noopener"><small>WhatsApp</small><span>Message Nora’s Upholstery</span></a>
          <div><small>Based in</small><span>Richmond Hill, Ontario</span></div>
        </div>
        <div class="contact-practical-note">
          <div>
            <strong>Typical response time</strong>
            <p>We aim to reply within one business day. Weekend dental work should be requested as early as possible.</p>
          </div>
          <div>
            <strong>Planning a visit</strong>
            <p>Please call or email before visiting so we can arrange a time and prepare for your project.</p>
          </div>
        </div>
      </aside>

      <div class="contact-form-card">
        <div class="optional-form-heading"><p class="eyebrow">Request an estimate</p><p>Send your contact details and project description, with photos if you have them.</p></div>
        <div class="form-confirmation" data-form-confirmation role="status" aria-live="polite" tabindex="-1" hidden={!formWasSent}>
          <strong>Estimate request sent</strong>
          <span>Thank you — your project details have been sent. We’ll be in touch soon.</span>
        </div>
        <div class="estimate-reassurance" aria-label="Estimate request information">
          <div><strong><span aria-hidden="true">✓</span> Free, no-obligation estimates</strong><span>Tell us about your project and we’ll help you understand the next step.</span></div>
          <div><strong><span aria-hidden="true">✓</span> Reply within one business day</strong><span>Weekend dental work should be requested as early as possible.</span></div>
          <div><strong><span aria-hidden="true">✓</span> Photos are helpful, not required</strong><span>Include them when you can for a faster, more accurate estimate.</span></div>
        </div>
        <!--
          CLOUDFLARE FORM NOTE
          This form posts to /api/quote, implemented in functions/api/quote.ts.
          In Cloudflare Pages, add RESEND_API_KEY, QUOTE_TO_EMAIL,
          QUOTE_FROM_EMAIL and TURNSTILE_SECRET_KEY as secrets. Never
          commit their values.
          Photo uploads are limited to three files and 8 MB per file.
        -->
        <form class="quote-form" id="estimate-form" method="POST" action="/api/quote" enctype="multipart/form-data" data-quote-form>
          <label>Full name<input name="name" autocomplete="name" maxlength="100" required /></label>
          <label>Email address<input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
          <label>Phone number<input type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="30" required /></label>
          <label>City<input name="city" autocomplete="address-level2" maxlength="100" required /></label>
          <label class="full">What would you like restored?<input name="item" maxlength="160" placeholder="e.g. chiropractic table, four dining chairs" required /></label>
          <label class="full">Project details<textarea name="message" rows="5" maxlength="3000" placeholder="Tell us about condition, timing, colour or material preferences" required></textarea></label>
          <label class="full"><span class="field-label">How did you hear about Nora’s Upholstery? <small>(optional)</small></span>
            <select name="referralSource" data-referral-source>
              <option value="">Please select</option>
              <option value="Google">Google</option>
              <option value="Instagram">Instagram</option>
              <option value="Facebook">Facebook</option>
              <option value="Referral">Referral</option>
              <option value="Returning customer">Returning customer</option>
              <option value="ODA or OCA magazine/advertisement">ODA or OCA magazine / advertisement</option>
              <option value="Other">Other</option>
            </select>
          </label>
          <label class="full referral-detail" hidden data-referral-detail>Who referred you, or where did you hear about us?<input name="referralDetail" maxlength="160" placeholder="e.g. Dr. Smith at ABC Dental" /></label>
          <label class="full upload-field">
            Add up to five photos <small>(optional)</small>
            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple data-photo-input />
            <span>JPG, PNG, WebP, HEIC or HEIF · maximum 5 files and 5 MB each</span>
          </label>
          <label class="honeypot" aria-hidden="true">Leave this blank<input name="website" tabindex="-1" autocomplete="off" /></label>
          <div class="full form-submit">
            {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="estimate_request" data-theme="light" data-appearance="interaction-only"></div>}
            <div class="form-submit__actions">
              <button class="button button--dark" type="submit">Send estimate request</button>
              <p class:list={{ 'is-success': formWasSent, 'is-error': Boolean(formError) }} data-form-status role="status" aria-live="polite" tabindex="-1">{initialFormStatus}</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.querySelector('[data-quote-form]');
    const input = document.querySelector('[data-photo-input]');
    const referralSource = document.querySelector('[data-referral-source]');
    const referralDetail = document.querySelector('[data-referral-detail]');
    const referralDetailInput = referralDetail?.querySelector('input');
    const status = document.querySelector('[data-form-status]');
    const formConfirmation = document.querySelector('[data-form-confirmation]');
    const submitButton = form?.querySelector('button[type="submit"]');
    const allowedTypes = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif']);
    const maxPhotos = 5;
    const maxPhotoSize = 5 * 1024 * 1024;
    const showStatus = (message, state = '') => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-error', state === 'error');
      status.classList.toggle('is-success', state === 'success');
    };
    input?.addEventListener('change', () => {
      const files = Array.from(input.files || []);
      if (files.length > maxPhotos || files.some((file) => file.size > maxPhotoSize || !allowedTypes.has(file.type))) {
        input.value = '';
        showStatus('Choose up to 5 JPG, PNG, WebP, HEIC or HEIF photos, each smaller than 5 MB.', 'error');
      } else if (files.length) showStatus(`${files.length} photo${files.length > 1 ? 's' : ''} ready to send.`);
    });
    referralSource?.addEventListener('change', () => {
      const showDetail = referralSource.value === 'Referral' || referralSource.value === 'Other';
      if (referralDetail) referralDetail.hidden = !showDetail;
      if (!showDetail && referralDetailInput) referralDetailInput.value = '';
    });
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submitButton) return;
      const turnstileToken = form.querySelector('input[name="cf-turnstile-response"]')?.value;
      if (!turnstileToken) {
        showStatus('Please wait for the security check to finish, then try again.', 'error');
        status?.focus({ preventScroll: true });
        return;
      }
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      const originalLabel = submitButton.textContent;
      submitButton.textContent = 'Sending…';
      showStatus('Sending your request…');
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'We could not send your request. Please try again or use one of the contact options.');
        form.reset();
        if (referralDetail) referralDetail.hidden = true;
        if (formConfirmation) {
          formConfirmation.hidden = false;
          formConfirmation.focus({ preventScroll: true });
        }
        showStatus('', 'success');
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'We could not send your request. Please try again.', 'error');
      } finally {
        window.turnstile?.reset();
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
        submitButton.textContent = originalLabel;
        status?.focus({ preventScroll: true });
      }
    });
  </script>
</BaseLayout>

<style>
  .page-hero h1 em, .contact-heading em { color: var(--saddle); font-weight: 400; }
  .contact-page-hero { padding-block: clamp(7rem, 7vw, 8rem) clamp(2.25rem, 3vw, 3rem); }
  .contact-page-hero h1 { max-width: 760px; font-size: clamp(3.8rem, 7.4vw, 6.8rem); }
  .contact-content { padding-block: clamp(2.25rem, 4vw, 4rem); }
  .contact-form-shell { align-items: start; gap: clamp(2.5rem, 5vw, 5.5rem); }
  .contact-heading { margin: .45rem 0 1.35rem; font-family: var(--serif); font-size: clamp(2.65rem, 4.2vw, 4.35rem); font-weight: 400; letter-spacing: -.04em; line-height: .9; }
  .contact-list { display: grid; margin-bottom: 1.35rem; border-top: 1px solid var(--line); }
  .contact-list a, .contact-list > div { display: grid; padding: .85rem 0; border-bottom: 1px solid var(--line); }
  .contact-list small { color: rgba(8,30,39,.5); font-size: .65rem; text-transform: uppercase; }
  .contact-list span { font-size: .88rem; }
  .contact-practical-note { display: grid; gap: 1rem; padding: 1.15rem; border-left: 2px solid var(--brass); background: rgba(238,226,205,.7); }
  .contact-practical-note > div + div { padding-top: 1rem; border-top: 1px solid rgba(8,30,39,.13); }
  .contact-practical-note strong { font-size: .78rem; }
  .contact-practical-note p { margin: .3rem 0 0; color: rgba(8,30,39,.72); font-size: .72rem; line-height: 1.5; }
  .travel-contact-card { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem 1rem; max-width: 760px; margin-top: 1.25rem; padding: 1rem 1.15rem; border-radius: 1rem; font-size: .72rem; }
  .travel-contact-card strong { width: 100%; }
  .travel-contact-card a { padding-bottom: .15rem; border-bottom: 1px solid var(--saddle); font-weight: 600; }
  .contact-form-card { padding: clamp(1.15rem, 2.5vw, 2rem); border: 1px solid var(--line); border-radius: 1.2rem; background: rgba(255,255,255,.35); box-shadow: 0 1rem 3.5rem rgba(8,30,39,.05); }
  .form-confirmation { display: grid; gap: .2rem; margin: 0 0 1rem; padding: .9rem 1rem; border-left: 3px solid #3d7a50; background: rgba(224,239,225,.72); color: #1f5131; }
  .form-confirmation strong { font-size: .78rem; }
  .form-confirmation span { font-size: .7rem; line-height: 1.45; }
  .optional-form-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1rem; padding-bottom: .8rem; border-bottom: 1px solid var(--line); }
  .optional-form-heading .eyebrow, .optional-form-heading > p:last-child { margin: 0; }
  .optional-form-heading > p:last-child { max-width: 340px; color: rgba(8,30,39,.58); font-size: .72rem; }
  .estimate-reassurance { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin: 0 0 1.1rem; }
  .estimate-reassurance > div { display: grid; gap: .3rem; padding: .75rem .8rem; border: 1px solid var(--line); border-radius: .7rem; background: rgba(255,255,255,.38); }
  .estimate-reassurance strong { display: flex; gap: .35rem; font-size: .66rem; line-height: 1.35; }
  .estimate-reassurance strong > span { flex: 0 0 auto; color: var(--saddle); font-weight: 700; }
  .estimate-reassurance span { color: rgba(8,30,39,.58); font-size: .61rem; line-height: 1.45; }
  .quote-form label small { color: rgba(8,30,39,.5); font-size: .62rem; font-weight: 400; }
  .quote-form select { height: 3.5rem; min-height: 3.5rem; }
  .quote-form select[name="referralSource"] { border-radius: 1.3rem; }
  .field-label { display: flex; align-items: baseline; gap: .35rem; }
  .upload-field input { padding: 1.15rem; border-style: dashed; }
  #estimate-form { scroll-margin-top: 8.5rem; }
  .upload-field > span { color: rgba(8,30,39,.48); font-size: .62rem; font-weight: 400; }
  .honeypot { position: absolute; left: -10000px; }
  .form-submit { display: grid; gap: .7rem; margin-top: .1rem; }
  .form-submit__actions { display: flex; align-items: center; gap: 1rem; }
  .form-submit .button { min-width: 12.75rem; border-radius: .85rem; }
  .form-submit p { margin: 0; color: rgba(8,30,39,.52); font-size: .65rem; }
  .form-submit p.is-success { color: #27623b; }
  .form-submit p.is-error { color: #9b3029; }
  .form-submit button:disabled { cursor: wait; opacity: .68; }
  @media (max-width: 820px) {
    .contact-page-hero { padding-bottom: 2rem; }
    .contact-form-shell { gap: 2.25rem; }
    .contact-side { display: contents; }
    .contact-side > .eyebrow, .contact-side > .contact-heading, .contact-side > .contact-list { order: 0; }
    .contact-practical-note { order: 2; }
    .contact-form-card { order: 1; }
    .optional-form-heading, .form-submit__actions { display: grid; }
    .estimate-reassurance { grid-template-columns: 1fr; }
    .form-submit .button { width: 100%; }
  }
</style>
