---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, travelContact, whatsappUrl } from '../data/business';
const title = "Request an Estimate | Nora's Upholstery";
const description = "Send photos and details for an upholstery estimate across the Greater Toronto Area.";
const formMessages: Record<string, string> = {
  missing: 'Please complete every required field.',
  invalid: 'Please check your email address and phone number.',
  files: 'Choose up to 3 valid JPG, PNG, WebP, HEIC or HEIF photos, each under 8 MB.',
  large: 'The upload is too large. Choose up to 3 photos under 8 MB each.',
  unavailable: 'The contact form is temporarily unavailable. Please call, email or message us on WhatsApp.',
  send: 'We could not send your request. Please try again or use one of the contact options.',
};
const formWasSent = Astro.url.searchParams.get('sent') === '1';
const formError = Astro.url.searchParams.get('error') || '';
const initialFormStatus = formWasSent
  ? 'Thank you. Your project details have been sent and we will be in touch soon.'
  : formMessages[formError] || '';
---
<BaseLayout {title} {description}>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Choose what works for you</p>
      <h1>Let’s talk about<br /><em>your project.</em></h1>
      <p>Call, email, message us on WhatsApp or use the contact form, whichever is most convenient. You can include photos when they are helpful, but they are not required to get started.</p>
      {travelContact.enabled && (
        <div class="travel-contact-card glass">
          <strong>{travelContact.notice}</strong>
          <a href={whatsappUrl} target="_blank" rel="noopener">Message us on WhatsApp <span>↗</span></a>
          <a href={`mailto:${business.email}`}>Email us <span>↗</span></a>
        </div>
      )}
    </div>
  </header>

  <section class="content-section">
    <div class="shell form-shell">
      <aside>
        <p class="eyebrow">Contact options</p>
        <h2 class="display-heading contact-heading">Choose how you would<br /><em>like to get started.</em></h2>
        <div class="contact-list">
          <a href="tel:+16479812622"><small>Call</small><span>647 981 2622</span></a>
          <a href="mailto:norasupholstery@gmail.com"><small>Email</small><span>norasupholstery@gmail.com</span></a>
          <a href={whatsappUrl} target="_blank" rel="noopener"><small>WhatsApp</small><span>Message Nora’s Upholstery</span></a>
          <div><small>Based in</small><span>Richmond Hill, Ontario</span></div>
        </div>
        <div class="form-note">
          <strong>Typical response time</strong>
          <p>We aim to reply within one business day. Weekend dental work should be requested as early as possible.</p>
        </div>
        <div class="form-note">
          <strong>Planning a visit</strong>
          <p>Please call or email before visiting so we can arrange a time and prepare for your project.</p>
        </div>
      </aside>

      <div>
        <div class="optional-form-heading"><p class="eyebrow">Contact form</p><p>Send your contact details and project description, with photos if you have them.</p></div>
        <!--
          CLOUDFLARE FORM NOTE
          This form posts to /api/quote, implemented in functions/api/quote.ts.
          In Cloudflare Pages, add a secret named QUOTE_WEBHOOK_URL pointing to
          your chosen email/form endpoint. Never commit that URL or its token.
          Photo uploads are limited to three files and 8 MB per file.
        -->
        <form class="quote-form" id="estimate-form" method="POST" action="/api/quote" enctype="multipart/form-data" data-quote-form>
          <label>Full name<input name="name" autocomplete="name" maxlength="100" required /></label>
          <label>Email address<input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
          <label>Phone number<input type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="30" required /></label>
          <label>City<input name="city" autocomplete="address-level2" maxlength="100" required /></label>
          <label class="full">What would you like restored?<input name="item" maxlength="160" placeholder="e.g. chiropractic table, four dining chairs" required /></label>
          <label class="full">Project details<textarea name="message" rows="5" maxlength="3000" placeholder="Tell us about condition, timing, colour or material preferences" required></textarea></label>
          <label class="full upload-field">
            Add up to three photos <small>(optional)</small>
            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple data-photo-input />
            <span>JPG, PNG, WebP, HEIC or HEIF · maximum 3 files and 8 MB each</span>
          </label>
          <label class="honeypot" aria-hidden="true">Leave this blank<input name="website" tabindex="-1" autocomplete="off" /></label>
          <div class="full form-submit">
            <button class="button button--dark" type="submit">Send estimate request</button>
            <p class:list={{ 'is-success': formWasSent, 'is-error': Boolean(formError) }} data-form-status role="status" aria-live="polite" tabindex="-1">{initialFormStatus}</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.querySelector('[data-quote-form]');
    const input = document.querySelector('[data-photo-input]');
    const status = document.querySelector('[data-form-status]');
    const submitButton = form?.querySelector('button[type="submit"]');
    const allowedTypes = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif']);
    const showStatus = (message, state = '') => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-error', state === 'error');
      status.classList.toggle('is-success', state === 'success');
    };
    input?.addEventListener('change', () => {
      const files = Array.from(input.files || []);
      if (files.length > 3 || files.some((file) => file.size > 8 * 1024 * 1024 || !allowedTypes.has(file.type))) {
        input.value = '';
        showStatus('Choose up to 3 JPG, PNG, WebP, HEIC or HEIF photos, each smaller than 8 MB.', 'error');
      } else if (files.length) showStatus(`${files.length} photo${files.length > 1 ? 's' : ''} ready to send.`);
    });
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submitButton) return;
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      const originalLabel = submitButton.textContent;
      submitButton.textContent = 'Sending…';
      showStatus('Sending your request…');
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'We could not send your request. Please try again or use one of the contact options.');
        form.reset();
        showStatus('Thank you. Your project details have been sent and we will be in touch soon.', 'success');
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'We could not send your request. Please try again.', 'error');
      } finally {
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
        submitButton.textContent = originalLabel;
        status?.focus({ preventScroll: true });
      }
    });
  </script>
</BaseLayout>

<style>
  .page-hero h1 em, .contact-heading em { color: var(--saddle); font-weight: 400; }
  .contact-heading { margin-bottom: 1.5rem; font-size: clamp(3.2rem, 6vw, 5.5rem); }
  .contact-list { display: grid; margin-bottom: 1.5rem; border-top: 1px solid var(--line); }
  .contact-list a, .contact-list > div { display: grid; padding: .85rem 0; border-bottom: 1px solid var(--line); }
  .contact-list small { color: rgba(8,30,39,.5); font-size: .65rem; text-transform: uppercase; }
  .contact-list span { font-size: .88rem; }
  .travel-contact-card { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem 1rem; max-width: 760px; margin-top: 1.25rem; padding: 1rem 1.15rem; border-radius: 1rem; font-size: .72rem; }
  .travel-contact-card strong { width: 100%; }
  .travel-contact-card a { padding-bottom: .15rem; border-bottom: 1px solid var(--saddle); font-weight: 600; }
  .optional-form-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.1rem; padding-bottom: .8rem; border-bottom: 1px solid var(--line); }
  .optional-form-heading .eyebrow, .optional-form-heading > p:last-child { margin: 0; }
  .optional-form-heading > p:last-child { max-width: 340px; color: rgba(8,30,39,.58); font-size: .72rem; }
  .upload-field input { padding: 1.15rem; border-style: dashed; }
  #estimate-form { scroll-margin-top: 7rem; }
  .upload-field > span { color: rgba(8,30,39,.48); font-size: .62rem; font-weight: 400; }
  .honeypot { position: absolute; left: -10000px; }
  .form-submit { display: flex; align-items: center; gap: 1rem; }
  .form-submit p { margin: 0; color: rgba(8,30,39,.52); font-size: .65rem; }
  .form-submit p.is-success { color: #27623b; }
  .form-submit p.is-error { color: #9b3029; }
  .form-submit button:disabled { cursor: wait; opacity: .68; }
  @media (max-width: 820px) { .optional-form-heading, .form-submit { display: grid; } .form-submit .button { width: 100%; } }
</style>
