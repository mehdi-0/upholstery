---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import { serviceFamilies } from '../../data/serviceFamilies';
const title = "Upholstery Services in the GTA | Nora's Upholstery";
const description = "Dental chair, medical, chiropractic, residential and commercial upholstery across Richmond Hill, the GTA and Southern Ontario by request.";
---
<BaseLayout {title} {description}>
  <section class="services-page shell pt-28 md:pt-32 pb-14">
    <header class="services-page__header">
      <p class="kicker-gold">What we do</p>
      <h1>Upholstery for<br /><em>every seat and setting.</em></h1>
      <p>Clinical work is our specialty, with the same material knowledge and careful finish applied to homes and commercial spaces.</p>
    </header>

    <div class="service-image-grid">
      {serviceFamilies.map(family => (
        <article class="service-overview-family" aria-labelledby={`overview-family-${family.id}`}>
          <a href={family.href} class="service-image-card" aria-labelledby={`overview-family-${family.id} overview-explore-${family.id}`}>
            <img src={family.image} alt="" loading="lazy" />
            <span class="service-image-card__wash" aria-hidden="true"></span>
            <div class="service-image-card__glass">
              <span>{family.number}</span>
              <h2 id={`overview-family-${family.id}`}>{family.name}</h2>
              <p>{family.description}</p>
              <strong><span id={`overview-explore-${family.id}`}>Explore the family</span><i aria-hidden="true">→</i></strong>
            </div>
          </a>
          <div class="service-overview-family__links"><ServiceLinks services={family.services} columns /></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .service-overview-family { min-width: 0; border-radius: 1.6rem; background: rgba(255,255,255,.3); }
  .service-overview-family__links { container-type: inline-size; padding: .85rem; }
  @media (max-width: 820px) {
    .service-overview-family .service-image-card { min-height: 320px; max-height: none; }
  }
</style>
