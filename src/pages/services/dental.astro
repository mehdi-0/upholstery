---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { serviceSchema } from '../../data/business';
const title = "Dental Upholstery | Nora's Upholstery";
const description = "Dental chair, stool and operatory upholstery with cleanable clinical materials and weekend rush options.";
const structuredData = serviceSchema((Astro.site ?? Astro.url).origin, {
  name: 'Dental upholstery',
  description,
  path: '/services/dental/',
  serviceTypes: ['Dental chair upholstery', 'Dentist chair upholstery', 'Dental assistant stool upholstery', 'Dental chair foam repair'],
});
const categories = [
  { number: '01', title: 'Patient chairs', copy: 'Full or partial reupholstering for dental treatment chairs, including headrests, backrests, seats, leg rests, arm pads and foot covers.', examples: ['Treatment chairs', 'Headrests & cushions', 'Seats & backrests', 'Arm & leg pads', 'Foot covers'], image: '/images/dental-patient-chairs.webp', photo: 'Completed patient chair', alt: 'Reupholstered dental patient chair in a professional operatory', href: '/services/dental/dental-chair-upholstery', linkLabel: 'Explore dental chair upholstery' },
  { number: '02', title: 'Dental assistant seating', copy: 'Antifungal, antibacterial, supportive and cleanable upholstery vinyl is used for dentist chairs and assistant stools throughout the operatory clinic.', examples: ['Dentist chairs', 'Dental assistant stools', 'Saddle stools'], image: '/images/dental-operator-seating.webp', photo: 'Dentist chair or dental assistant stool', alt: 'Professionally reupholstered dentist chair and dental assistant stool', href: '/services/dental/dental-stool-upholstery', linkLabel: 'Explore dental team seating' },
  { number: '03', title: 'Repairs & rebuilding', copy: 'Repairs are more than a surface change. Damaged foam, contours and frames can be rebuilt before new materials are fitted.', examples: ['Foam replacement', 'Contour shaping', 'Seam & panel repair'], image: '/images/dental-repairs.webp', photo: 'Foam or contour repair', alt: 'Dental chair foam and upholstery repair in progress', href: '/services/dental/dental-chair-repair', linkLabel: 'Explore dental chair repair' },
  { number: '04', title: 'Practice coordination', copy: 'Medical vinyl, colour selection, scheduling, pickup and delivery are all planned around the needs of an active dental practice.', examples: ['Medical vinyl', 'Weekend rush options', 'Pickup & delivery'], image: '/images/dental-practice.webp', photo: 'Coordinated clinic finish', alt: 'Coordinated upholstered dental seating in a professional clinic' },
];
---
<BaseLayout {title} {description} {structuredData}>
  <section class="individual-service shell">
    <header class="individual-service__hero">
      <Breadcrumbs items={[
        { name: 'Home', href: '/' },
        { name: 'Services', href: '/services' },
        { name: 'Dental' },
      ]} />
      <p class="kicker-gold">Dental upholstery</p>
      <h1>Every surface in<br /><em>the operatory.</em></h1>
      <p>From the patient chair to dentist chairs and dental assistant stools, we restore the pieces your team and patients depend on using precise patterns and materials appropriate for healthcare settings.</p>
    </header>
    <div class="individual-service__grid">
      {categories.map(category => (
        <article class="individual-service__card glass">
          <div class="individual-service__media"><div><span>{category.photo}</span><small>Photo slot</small></div><img src={category.image} alt={category.alt} loading="lazy" onerror="this.hidden=true" /></div>
          <div class="individual-service__body"><span>{category.number}</span><h2>{category.title}</h2><p>{category.copy}</p><ul>{category.examples.map(example => <li>{example}</li>)}</ul>{category.href && <a class="individual-service__detail-link" href={category.href}><span>{category.linkLabel}</span><span aria-hidden="true">→</span></a>}</div>
        </article>
      ))}
    </div>
    <div class="individual-service__cta glass-dark">
      <div><p class="eyebrow">Free estimates available</p><h2>Send photos of the chair or parts.</h2></div>
      <a href="tel:+16479812622" class="button button--light">Call about dental upholstery</a>
    </div>
  </section>
</BaseLayout>
