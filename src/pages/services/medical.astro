---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceAreaLinks from '../../components/ServiceAreaLinks.astro';
import { serviceSchema } from '../../data/business';
import { getProjectCardImage, getServiceFeaturedProjectId } from '../../data/evidence';
import { ophthalmicService, physiotherapyService } from '../../data/serviceDetails';
const physiotherapyProjectId = getServiceFeaturedProjectId(physiotherapyService);
const ophthalmicProjectId = getServiceFeaturedProjectId(ophthalmicService);
const physiotherapyCardImage = physiotherapyProjectId ? getProjectCardImage(physiotherapyProjectId, 'after') : undefined;
const ophthalmicCardImage = ophthalmicProjectId ? getProjectCardImage(ophthalmicProjectId, 'after') : undefined;
const title = "Medical & Chiropractic Upholstery in the GTA | Nora's Upholstery";
const description = "Medical tables, chiropractic beds, clinic stools and waiting seating restored across the GTA with cleanable healthcare materials.";
const structuredData = serviceSchema((Astro.site ?? Astro.url).origin, {
  name: 'Medical and chiropractic upholstery',
  description,
  path: '/services/medical/',
  serviceTypes: ['Medical exam table upholstery', 'Chiropractic table upholstery', 'Physiotherapy and treatment table upholstery', 'Clinic seating upholstery', 'Ophthalmic upholstery', 'Clinical foam rebuilding'],
});
type Category = {
  number: string;
  title: string;
  copy: string;
  examples: string[];
  image?: string;
  photo: string;
  alt?: string;
  href?: string;
  linkLabel?: string;
};
const categories: Category[] = [
  { number: '01', title: 'Medical exam tables', copy: 'Professional reupholstering for examination and treatment surfaces in clinics and allied health practices.', examples: ['Exam tables', 'Treatment tables', 'Procedure chair cushions'], image: '/images/medical-exam-tables.webp', photo: 'Exam or treatment table', alt: 'Black padded examination table beneath wall mounted clinical equipment', href: '/services/medical/medical-exam-table-upholstery', linkLabel: 'Explore medical exam tables' },
  { number: '02', title: 'Chiropractic tables', copy: 'Chiropractic tables, segmented cushions and adjustment table components require special care because they are adjusted for every patient. Trust us to repair, replace and restore them for lasting performance and durability.', examples: ['Adjustment tables', 'Drop section cushions', 'Head & ankle sections'], image: '/images/medical-chiropractic-tables.webp', photo: 'Chiropractic table', alt: 'Reupholstered chiropractic adjustment table with segmented cushions', href: '/services/medical/chiropractic-table-upholstery', linkLabel: 'Explore chiropractic tables' },
  { number: '03', title: 'Physiotherapy & treatment tables', copy: 'Upholstery for physiotherapy and treatment tables, including complete tables, individual sections and foam restoration.', examples: ['Treatment tables', 'Individual sections', 'Foam renewal'], image: physiotherapyCardImage?.src, photo: 'Physiotherapy treatment tables', alt: physiotherapyCardImage?.alt, href: physiotherapyService.path, linkLabel: 'Explore physiotherapy tables' },
  { number: '04', title: 'Clinic and patient seating', copy: 'Upholstery for patient and staff seating, selected for comfort, durability and the clinic’s cleaning routine.', examples: ['Dialysis chairs', 'Practitioner stools', 'Waiting room and reception chairs'], image: '/images/medical-clinic-seating.webp', photo: 'Clinic or patient seating', alt: 'Rows of blue waiting chairs along a clinic hallway', href: '/services/medical/clinic-seating-upholstery', linkLabel: 'Explore clinic seating' },
  { number: '05', title: 'Ophthalmic upholstery', copy: 'Upholstery for ophthalmic examination chairs, procedure chairs, stools and other upholstered equipment used in eye care.', examples: ['Examination chairs', 'Ophthalmic stools', 'Padding & covers'], image: ophthalmicCardImage?.src, photo: 'Ophthalmic seating', alt: ophthalmicCardImage?.alt, href: ophthalmicService.path, linkLabel: 'Explore ophthalmic upholstery' },
  { number: '06', title: 'Clinical rebuilding', copy: 'Worn foam, split vinyl and damaged contours can be repaired with cleanable finishes selected for the clinical setting.', examples: ['Foam rebuilding', 'Upholstery repair'], image: '/images/medical-rebuilding.webp', photo: 'Clinical rebuilding detail', alt: 'A person working beneath an upholstered clinical chair in a workshop', href: '/services/medical/clinical-upholstery-repair', linkLabel: 'Explore clinical rebuilding' },
];
---
<BaseLayout {title} {description} {structuredData}>
  <section class="individual-service shell">
    <header class="individual-service__hero">
      <Breadcrumbs items={[
        { name: 'Home', href: '/' },
        { name: 'Services', href: '/services' },
        { name: 'Medical & Chiropractic' },
      ]} />
      <p class="kicker-gold">Medical & chiropractic</p>
      <h1>Medical and chiropractic<br /><em>upholstery for patient care.</em></h1>
      <p>We restore medical and chiropractic tables, treatment equipment, patient seating and clinic furniture. Physiotherapy tables, eye care chairs and other clinical equipment are part of the work we do.</p>
    </header>
    <div class="individual-service__grid">
      {categories.map(category => (
        <article class="individual-service__card glass">
          <div class="individual-service__media"><div><span>{category.photo}</span>{category.image && <small>Photo slot</small>}</div>{category.image && <img src={category.image} alt={category.alt ?? ''} loading="lazy" data-hide-on-error />}</div>
          <div class="individual-service__body"><span>{category.number}</span><h2>{category.title}</h2><p>{category.copy}</p><ul>{category.examples.map(example => <li>{example}</li>)}</ul>{category.href && category.linkLabel && <a class="individual-service__detail-link" href={category.href}><span>{category.linkLabel}</span><span aria-hidden="true">→</span></a>}</div>
        </article>
      ))}
    </div>
    <ServiceAreaLinks serviceName="Medical & chiropractic upholstery" intro="We work with clinics throughout Richmond Hill, Vaughan, Toronto, Scarborough, Markham and Woodbridge on tables, beds, stools and waiting seating." />
    <div class="individual-service__cta glass-dark">
      <div><p class="eyebrow">Minimize clinic downtime</p><h2>Tell us what your practice needs.</h2></div>
      <a href="/contact#estimate-form" class="button button--light">Request a medical estimate</a>
    </div>
  </section>
</BaseLayout>
