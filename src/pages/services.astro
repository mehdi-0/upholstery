---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Services — Nora's Upholstery";
const description = "Medical and residential upholstery: dental chairs, chiropractic tables, gym pads, restaurant booths, sofas, dining chairs, ottomans, marine and more.";
const services = [
  { name: "Dental chairs & stools", desc: "Weekend rush available. Precise patterning, medical vinyls, foam repair."},
  { name: "Chiropractic & exam tables", desc: "Loaner bed available on request to avoid downtime."},
  { name: "Fitness equipment pads", desc: "Treadmills, benches, selectorized machines—durable, antibacterial fabrics."},
  { name: "Restaurant & hospitality seating", desc: "Booths, banquettes, waiting room seating—on‑site options available."},
  { name: "Residential furniture", desc: "Sofas, dining chairs, ottomans and cushions."},
  { name: "Marine & specialty", desc: "Boat seats and custom panels."},
];
---
<BaseLayout {title} {description}>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">Services</h1>
    <div class="grid md:grid-cols-2 gap-6">
      {services.map(s => (
        <div class="p-6 rounded-xl border bg-white/80">
          <h3 class="font-semibold">{s.name}</h3>
          <p class="text-sm mt-2">{s.desc}</p>
        </div>
      ))}
    </div>
    <div class="mt-10">
      <a href="/contact#quote" class="btn-primary">Get a Quote</a>
    </div>
  </section>
</BaseLayout>
