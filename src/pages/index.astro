---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, phoneHref } from '../data/business';
import { getReview, getReviewExcerpt, getReviewSourceUrl } from '../data/reviews';
import { servicePaths } from '../data/servicePaths';
import { homepageFeaturedReviewId } from '../data/evidenceCuration';

const title = "Nora's Upholstery | Precision restoration across the GTA";
const description = "Dental chair, medical, chiropractic, residential and commercial upholstery with careful patterning, durable materials and pickup across Richmond Hill and the Greater Toronto Area.";
const davidReview = getReview(homepageFeaturedReviewId);
const davidReviewExcerpt = getReviewExcerpt(davidReview, 'homepage');
const davidReviewUrl = getReviewSourceUrl(davidReview) ?? business.googleProfileUrl;

const services = [
  { number: '01', title: 'Dental', detail: 'Dental chairs, stools and clinic seating.', href: '/services/dental' },
  { number: '02', title: 'Medical & chiropractic', detail: 'Exam tables, chiropractic beds, stools and clinic seating.', href: '/services/medical' },
  { number: '03', title: 'Residential & outdoor', detail: 'Sofas, dining chairs, outdoor cushions and selected boat seating.', href: '/services/residential' },
  { number: '04', title: 'Commercial', detail: 'Restaurants, gyms, bowling centres, reception areas and hospitality seating.', href: '/services/commercial' },
];

const process = [
  ['01', 'Send a few photos', 'Show us the whole piece and what needs work.'],
  ['02', 'Choose the finish', 'We’ll help you select the right fabric, vinyl and colour.'],
  ['03', 'We restore it', 'Our team brings your furniture back to life.'],
];
---
<BaseLayout {title} {description} includeSiteSchema>
  <section class="hero">
    <div class="hero__media hero__media--placeholder" aria-hidden="true">
      <span class="hero__fabric-plane"></span>
      <svg class="hero__craft-visual" viewBox="0 0 1600 900" preserveAspectRatio="none">
        <defs>
          <mask id="hero-thread-reveal" maskUnits="userSpaceOnUse">
            <path class="hero__thread-mask" pathLength="1" d="M 934 432 C 825 399, 758 319, 648 270 C 526 215, 398 237, 294 307" />
          </mask>
        </defs>
        <path class="hero__thread" mask="url(#hero-thread-reveal)" d="M 934 432 C 825 399, 758 319, 648 270 C 526 215, 398 237, 294 307" />
        <path class="hero__thread-double" d="M 924 446 C 844 418, 790 362, 726 326" />
        <g class="hero__needle" transform="translate(932 432) rotate(-19)">
          <path class="hero__needle-body" d="M 0 0 L 94 0" />
          <ellipse class="hero__needle-eye" cx="89" cy="0" rx="5.5" ry="2.3" />
        </g>
      </svg>
    </div>
    <div class="hero__wash" aria-hidden="true"></div>
    <div class="shell hero__content">
      <div class="hero__copy reveal">
      <p class="eyebrow eyebrow--light">A family upholstery business serving the GTA</p>
        <h1>Precision<br />upholstery,<br /><em>shaped by hand.</em></h1>
        <p class="hero__intro">We renew upholstery for dental and medical clinics, homes and businesses. Nora stays in touch throughout your project, so you always have someone familiar to reach out to.</p>
        <div class="hero__actions">
          <a class="button button--light" href={phoneHref}>Call for an estimate</a>
          <a class="button hero__form-button" href="/contact#estimate-form">Get a free estimate</a>
          <a class="text-link text-link--light" href="/before-after">Explore our work <span>↗</span></a>
        </div>
      </div>

      <aside class="hero-proof glass-clear reveal" aria-label="Service information">
				<img class="hero-proof__legacy-logo" src="/legacy-logo-glass.webp" alt="Nora's Upholstery legacy medical, chiropractic and dental upholstery logo" width="500" height="246" decoding="async" />
        <div><strong>Experience since 1989</strong><span>Based in Richmond Hill</span></div>
        <div><strong>Flexible scheduling</strong><span>Rush and weekend options</span></div>
        <div><strong>Pickup and delivery across the GTA</strong></div>
      </aside>
    </div>
    <a class="hero__scroll" href="#work">Scroll to discover <span>↓</span></a>
  </section>

  <section class="services-section section" id="work">
    <div class="shell">
      <div class="section-heading section-heading--compact">
        <div><p class="eyebrow">Choose your project</p><h2 class="display-heading">Specialized care.<br /><em>A clear place to begin.</em></h2></div>
        <a class="text-link desktop-only" href="/services">See all services <span>↗</span></a>
      </div>
      <div class="service-rail" aria-label="Upholstery services">
        {services.map((service) => (
          <a class="service-card glass-service" href={service.href}>
            <span>{service.number}</span><h3>{service.title}</h3><p>{service.detail}</p><i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-review section">
    <div class="shell home-review__grid">
      <div class="home-review__intro">
        <p class="eyebrow">A client’s perspective</p>
        <h2 class="display-heading">Trusted after<br /><em>the work is done.</em></h2>
          <p>Hear from the people who trusted us with their furniture.</p>
        <div class="home-review__links">
          <a class="text-link" href="/testimonials">Read client reviews <span>↗</span></a>
          <a class="text-link" href={servicePaths.chiropracticTable}>Explore chiropractic table upholstery <span>↗</span></a>
        </div>
      </div>
      <blockquote class="home-review__quote glass-dark">
        <div class="home-review__source"><span class="home-review__google"><img src="/icons/google.svg" alt="" />{davidReview.sourceLabel}</span></div>
        <p>“{davidReviewExcerpt}”</p>
        <footer><strong>{davidReview.reviewerDisplayName}</strong><span>{davidReview.contextLabel}</span><a href={davidReviewUrl} target="_blank" rel="noopener">View on Google ↗</a></footer>
      </blockquote>
    </div>
  </section>

  <section class="project-feature section">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Featured transformation</p><h2 class="display-heading">Proof is in<br /><em>the finish.</em></h2></div>
        <p>See a dental chair before and after restoration.</p>
      </div>
      <div class="project-stage project-stage--crossfade" data-crossfade>
        <div class="crossfade-viewer">
			<img class="crossfade-viewer__image crossfade-viewer__image--before" src="/images/home-dental-before-720.webp" srcset="/images/home-dental-before-720.webp 720w, /images/home-dental-before-1120.webp 1120w" sizes="(max-width: 760px) calc(100vw - 2rem), 620px" width="1120" height="1400" alt="Burgundy dental chair with damaged upholstery before restoration" loading="lazy" decoding="async" />
			<img class="crossfade-viewer__image crossfade-viewer__image--after" src="/images/home-dental-after-720.webp" srcset="/images/home-dental-after-720.webp 720w, /images/home-dental-after-1120.webp 1120w" sizes="(max-width: 760px) calc(100vw - 2rem), 620px" width="1120" height="1400" alt="Blue dental chair after upholstery restoration" loading="lazy" decoding="async" aria-hidden="true" />
          <span class="crossfade-viewer__label" data-crossfade-label>Before</span>
          <div class="crossfade-viewer__controls" aria-label="Choose before or after photograph">
            <button type="button" aria-pressed="true" data-crossfade-show="before">Before</button>
            <button type="button" aria-pressed="false" data-crossfade-show="after">After</button>
          </div>
        </div>
        <aside class="project-card glass-frosted">
          <p class="eyebrow">Project 01</p>
          <h3>Dental chair renewal</h3>
          <dl>
            <div><dt>Material</dt><dd>Medical-grade vinyl · antibacterial &amp; antifungal</dd></div>
            <div><dt>Work</dt><dd>Damaged foam repair + complete upholstery</dd></div>
            <div><dt>Turnaround</dt><dd>One weekend</dd></div>
            <div><dt>Setting</dt><dd>Dental clinic</dd></div>
          </dl>
          <a class="text-link" href="/before-after">View more projects <span>↗</span></a>
        </aside>
      </div>
    </div>
  </section>

  <section class="process-section section">
    <div class="shell">
      <p class="eyebrow">A simple process</p>
      <h2 class="display-heading">From first photo<br /><em>to finished piece.</em></h2>
      <div class="process-grid">
        {process.map(([number, heading, copy]) => <article><span>{number}</span><h3>{heading}</h3><p>{copy}</p></article>)}
      </div>
      <div class="process-action"><a class="button button--dark" href="/contact#estimate-form">Request a free estimate</a></div>
    </div>
  </section>

  <script is:inline>
    const serviceRail = document.querySelector('.service-rail');
    serviceRail?.addEventListener('focusin', (event) => {
      const focusedCard = event.target.closest('.service-card');
      if (!focusedCard || !focusedCard.matches(':focus-visible') || !window.matchMedia('(max-width: 820px)').matches) return;
      focusedCard.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
    });

    const crossfade = document.querySelector('[data-crossfade]');
    const crossfadeLabel = crossfade?.querySelector('[data-crossfade-label]');
    const crossfadeButtons = crossfade?.querySelectorAll('[data-crossfade-show]');
    crossfadeButtons?.forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.crossfadeShow;
        crossfade?.classList.toggle('show-after', view === 'after');
        crossfadeButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        crossfade?.querySelectorAll('.crossfade-viewer__image').forEach((image) => {
          image.setAttribute('aria-hidden', String(image.classList.contains('crossfade-viewer__image--after') !== (view === 'after')));
        });
        if (crossfadeLabel) crossfadeLabel.textContent = view === 'after' ? 'After' : 'Before';
      });
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      }), { threshold: 0.12 });
      document.querySelectorAll('.reveal, .service-card, .process-grid article').forEach((el) => observer.observe(el));
    }
  </script>
</BaseLayout>

<style>
  .project-stage--crossfade { display: grid; grid-template-columns: minmax(0, 1fr) 350px; max-width: 1050px; margin-inline: auto; gap: 1rem; align-items: center; }
  .project-stage--crossfade .project-card { position: relative; right: auto; bottom: auto; width: 100%; }
  .crossfade-viewer { position: relative; width: min(100%, 620px); aspect-ratio: 4 / 5; margin-inline: auto; border: 1px solid rgba(255,255,255,.62); border-radius: var(--radius); background: var(--ink); box-shadow: 0 28px 65px rgba(5,21,27,.16); overflow: hidden; }
  .crossfade-viewer__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .65s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1); }
  .crossfade-viewer__image--before { opacity: 1; transform: scale(1); }
  .crossfade-viewer__image--after { opacity: 0; transform: scale(1.015); }
  .show-after .crossfade-viewer__image--before { opacity: 0; transform: scale(1.015); }
  .show-after .crossfade-viewer__image--after { opacity: 1; transform: scale(1); }
  .crossfade-viewer__label { position: absolute; z-index: 2; top: 1rem; left: 1rem; padding: .55rem .85rem; border: 1px solid rgba(255,255,255,.45); border-radius: 999px; color: #fff; background: rgba(8,30,39,.46); font-size: .67rem; letter-spacing: .1em; text-transform: uppercase; -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .crossfade-viewer__controls { position: absolute; z-index: 3; right: 1rem; bottom: 1rem; display: grid; grid-template-columns: 1fr 1fr; padding: .25rem; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; background: rgba(247,243,235,.74); box-shadow: 0 12px 30px rgba(5,21,27,.18); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .crossfade-viewer__controls button { border: 0; border-radius: 999px; padding: .65rem .9rem; color: rgba(8,30,39,.62); background: transparent; font-size: .68rem; font-weight: 600; cursor: pointer; }
  .crossfade-viewer__controls button[aria-pressed='true'] { color: #fff; background: var(--ink); }
  #work { scroll-margin-top: 7rem; }
  @media (max-width: 820px) {
    .project-stage--crossfade { grid-template-columns: 1fr; }
    .project-stage--crossfade .project-card { width: min(100% - 1.2rem, 520px); margin: -.9rem auto 0; }
    .crossfade-viewer { width: 100%; border-radius: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .crossfade-viewer__image { transition: none; }
  }
</style>
