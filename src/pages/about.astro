---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
const title = "About Nora's Upholstery | Our Story";
const description = "Discover the story of Nora’s Upholstery, a family-owned Richmond Hill business founded by a professionally trained upholsterer with more than 40 years of experience.";
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-32 pb-10">
    <p class="kicker-gold mb-3">About Nora’s Upholstery</p>
    <h1 class="text-4xl font-semibold mb-5">Our Story</h1>
    <div class="story-intro">
      <div class="story-copy space-y-4">
        <p>Nora’s Upholstery is a proudly family-owned business built on craftsmanship, integrity and a genuine commitment to exceptional customer service.</p>
        <p>After immigrating to Toronto in 1984, Nora pursued her passion for upholstery at George Brown College, where she became a professionally trained upholsterer. Together with her husband, an electrician, she built Nora’s Upholstery from the ground up through hard work, dedication and a shared vision of creating a business known for quality and trust.</p>
        <p>As our family has grown over the years, so has our business. What began as a small family operation has expanded to serve a wide range of clients, including hospitals, gyms, dental clinics and other commercial and institutional organizations. Through that growth, we have maintained the personal attention and care that define who we are.</p>
        <p>Thank you for trusting our family with your upholstery needs. We look forward to serving you for many years to come.</p>
        <p>Please call or email before visiting so we can arrange a time and prepare for your project.</p>
      </div>
      <div class="founder-column">
        <figure class="founder-portrait glass">
          <img src="/images/founder-hassan.jpg" alt="Hassan, co-founder of Nora’s Upholstery, in the original workshop" width="750" height="1250" decoding="async" />
          <figcaption><strong>Hassan</strong><span>Co-founder, pictured in the original workshop</span></figcaption>
        </figure>
      </div>
    </div>
    <aside class="story-facts glass border hairline">
      <h2>Quick facts</h2>
      <ul>
        <li>Serving clients since 1984</li>
        <li>More than 40 years of experience</li>
        <li>Weekend rush for dental</li>
        <li>Pickup and delivery across the GTA</li>
      </ul>
    </aside>
    <PhotoStrip heading="Inside the craft" photos={[
      { src: '/images/about-workshop.webp', label: 'In the workshop', note: 'Hands cutting, sewing or fitting upholstery', alt: "Upholstery work underway in Nora's workshop" },
      { src: '/images/about-materials.webp', label: 'Materials & details', note: 'Vinyl, fabric, thread or careful seam work', alt: 'Upholstery materials and stitching details' },
    ]} />
  </section>
</BaseLayout>

<style>
  .story-intro { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .founder-column { min-width: 0; }
  .founder-portrait { overflow: hidden; border: 1px solid rgba(255,255,255,.72); border-radius: 1.5rem; background: rgba(255,255,255,.38); box-shadow: 0 22px 50px rgba(8,30,39,.1); }
  .founder-portrait img { display: block; width: 100%; max-height: 520px; aspect-ratio: 3 / 4; object-fit: cover; object-position: center 40%; filter: saturate(.84) contrast(1.03); }
  .founder-portrait figcaption { display: grid; gap: .15rem; padding: .9rem 1rem 1rem; }
  .founder-portrait figcaption strong { color: var(--ink); }
  .founder-portrait figcaption span { color: rgba(8,30,39,.62); font-size: .76rem; line-height: 1.35; }
  .story-facts { margin-top: clamp(1.5rem, 3vw, 2.25rem); padding: clamp(1.25rem, 2.5vw, 1.8rem); border-radius: 1.35rem; }
  .story-facts h2 { margin: 0 0 1rem; font-size: .95rem; font-weight: 650; }
  .story-facts ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem 1.5rem; margin: 0; padding: 0; list-style: none; }
  .story-facts li { position: relative; padding-left: 1rem; color: rgba(8,30,39,.76); font-size: .76rem; line-height: 1.45; }
  .story-facts li::before { content: ''; position: absolute; left: 0; top: .48em; width: .36rem; height: .36rem; border-radius: 50%; background: var(--brass); }
  @media (max-width: 820px) {
    .story-intro { grid-template-columns: 1fr; }
    .founder-column { margin-top: .5rem; }
    .founder-portrait { max-width: 32rem; }
    .founder-portrait img { max-height: none; aspect-ratio: 4 / 5; object-position: center 38%; }
    .story-facts ul { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .story-facts ul { grid-template-columns: 1fr; gap: .65rem; }
  }
</style>
