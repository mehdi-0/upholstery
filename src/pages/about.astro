---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "About — Nora's Upholstery";
const description = "Family‑run upholstery serving the GTA. We specialize in medical, fitness, hospitality and home furniture projects with careful workmanship and quick turnaround.";
---
<BaseLayout {title} {description}>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-6">About</h1>
    <div class="grid md:grid-cols-3 gap-8 items-start">
      <div class="md:col-span-2 space-y-4">
        <p>Nora’s Upholstery is a family‑run shop in Richmond Hill serving the Greater Toronto Area. We handle medical and dental chairs, chiropractic & exam tables, gym pads, restaurant booths, and home furniture.</p>
        <p>We’re known for reliable turnaround, careful patterning, and fabrics that match your environment—from antibacterial medical vinyls to durable commercial materials.</p>
        <p>Pickup and delivery available across the GTA.</p>
      </div>
      <div class="bg-white/80 border rounded-xl p-6">
        <h3 class="font-semibold mb-2">Fast facts</h3>
        <ul class="text-sm space-y-2 list-disc pl-5">
          <li>Typical turnaround: ~1 week</li>
          <li>Weekend rush for dental jobs</li>
          <li>Loaner chiropractic bed available</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
