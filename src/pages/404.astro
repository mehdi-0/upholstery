---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Page not found | Nora's Upholstery";
const description = "The page you requested could not be found. Explore Nora's upholstery services or contact the family team for help.";
---

<BaseLayout {title} {description}>
  <section class="not-found section">
    <div class="shell not-found__inner">
      <p class="eyebrow">Page not found</p>
      <h1 class="display-heading">Let’s get you<br /><em>back to the right place.</em></h1>
      <p>The page may have moved, but we are still here to help with your upholstery project.</p>
      <div class="not-found__actions">
        <a class="button button--dark" href="/">Return home</a>
        <a class="text-link" href="/services">Explore services <span>↗</span></a>
        <a class="text-link" href="/contact">Contact Nora’s <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: min(72svh, 720px); display: grid; align-items: center; }
  .not-found__inner { max-width: 920px; }
  .not-found h1 { margin-top: 1rem; }
  .not-found p:not(.eyebrow) { max-width: 620px; margin-top: 1.4rem; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.15rem); }
  .not-found__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
  @media (max-width: 820px) {
    .not-found { min-height: 60svh; }
  }
</style>
