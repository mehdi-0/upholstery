---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { absoluteUrl, business } from '../data/business';
import { assertEvidenceIntegrity } from '../data/evidence';
import { getProject, type Project } from '../data/projects';
import { getReview, getReviewSourceUrl, reviewsPageIds, type Review } from '../data/reviews';
import { servicePaths, type ServicePath } from '../data/servicePaths';
import { projectIds } from '../data/projects';

assertEvidenceIntegrity();
const title = "Client Reviews | Nora's Upholstery";
const description = "Selected client experiences with Nora's Upholstery, from chiropractic tables and ophthalmic chairs to medical clinics and dining chairs.";
const origin = (Astro.site ?? Astro.url).origin;
const pageUrl = absoluteUrl(origin, '/testimonials/');
const breadcrumbId = `${pageUrl}#breadcrumb`;
const structuredData = [{
  '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl,
  name: title, description, inLanguage: 'en-CA',
  isPartOf: { '@id': absoluteUrl(origin, '/#website') },
  about: { '@id': absoluteUrl(origin, '/#organization') },
  breadcrumb: { '@id': breadcrumbId },
}];
const serviceLabels: Record<ServicePath, string> = {
  [servicePaths.chiropracticTable]: 'Explore chiropractic table upholstery',
  [servicePaths.medicalHub]: 'Explore medical & chiropractic upholstery',
  [servicePaths.clinicSeating]: 'Explore clinic seating',
  [servicePaths.dentalChair]: 'Explore dental chair upholstery',
  [servicePaths.dentalChairRepair]: 'Explore dental chair repair',
  [servicePaths.dentalStool]: 'Explore dental team seating',
  [servicePaths.diningChairs]: 'Explore dining chair upholstery',
  [servicePaths.residentialChair]: 'Explore chair upholstery',
  [servicePaths.restaurantSeating]: 'Explore restaurant seating',
  [servicePaths.ophthalmic]: 'Explore ophthalmic upholstery',
  [servicePaths.physiotherapyTables]: 'Explore physiotherapy table upholstery',
};
const reviewArticles = reviewsPageIds.map((id) => {
  const review: Review = getReview(id);
  const project: Project | undefined = review.relatedProjectIds?.[0]
    ? getProject(review.relatedProjectIds[0]) : undefined;
  const servicePath = review.relatedServicePaths?.[0] ?? project?.servicePaths[0];
  return {
    review,
    context: review.contextLabel ?? project?.summaryItems?.join(' · ') ?? project?.summary,
    projectHref: project?.id === projectIds.ophthalmic ? `/before-after/#${project.id}` : undefined,
    sourceUrl: getReviewSourceUrl(review),
    sourceAction: review.sourceUrl ? 'View review on Google' : 'Visit Google profile',
    servicePath,
    serviceLabel: servicePath ? serviceLabels[servicePath] : undefined,
  };
});
---

<BaseLayout {title} {description} {structuredData} includeSiteSchema>
  <div class="reviews-page shell">
    <header class="reviews-hero">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Reviews' }]} schemaId={breadcrumbId} />
      <p class="eyebrow">Work remembered</p>
      <h1>What clients say <em>after the reveal.</em></h1>
      <p class="reviews-hero__intro">Selected client experiences with Nora’s Upholstery, from clinic equipment to the furniture they use every day.</p>
    </header>
    <section class="review-library" aria-label="Selected client reviews">
      {reviewArticles.map(({ review, context, projectHref, sourceUrl, sourceAction, servicePath, serviceLabel }) => (
        <article class:list={['review-article', review.id === 'david-song' && 'review-article--featured']} aria-labelledby={`review-${review.id}`}>
          <header class="review-article__metadata">
            <h2 id={`review-${review.id}`}>{review.reviewerDisplayName}</h2>
            <p class="review-article__source">{review.sourceLabel}</p>
            {review.rating && <p class="review-article__rating"><span aria-hidden="true">{'★'.repeat(review.rating)}</span><span class="visually-hidden">{review.rating} out of 5 stars</span></p>}
            {context && <p class="review-article__context">{projectHref ? <a href={projectHref}>{context}<span aria-hidden="true"> ↗</span></a> : context}</p>}
          </header>
          <blockquote class="review-article__quote"><p>{review.originalText}</p></blockquote>
          <div class="review-article__actions">
            {servicePath && <a class="review-article__service" href={servicePath}>{serviceLabel}<span aria-hidden="true"> ↗</span></a>}
            {sourceUrl && <a class="review-article__source-link" href={sourceUrl}>{sourceAction}</a>}
          </div>
        </article>
      ))}
    </section>
    <section class="reviews-google" aria-labelledby="reviews-google-heading">
      <div><h2 id="reviews-google-heading">More client experiences</h2><p>Continue reading on our Google profile.</p></div>
      <a class="reviews-google__link" href={business.googleProfileUrl}>Read more reviews on Google<span aria-hidden="true"> ↗</span></a>
    </section>
    <section class="reviews-estimate" aria-labelledby="reviews-estimate-heading">
      <div>
        <p class="eyebrow">Your project next</p>
        <h2 id="reviews-estimate-heading">A few photos are a good place to start.</h2>
        <p>Send us photographs of your furniture or equipment, and tell us what you’d like renewed. We’ll help you take the next step with an estimate.</p>
      </div>
      <a class="button button--dark" href="/contact#estimate-form">Send Photos for an Estimate</a>
    </section>
  </div>
</BaseLayout>

<style>
  .reviews-page { padding-block: clamp(7.5rem, 8vw, 9rem) clamp(2.5rem, 4vw, 4rem); }
  .reviews-hero { max-width: 54rem; padding-bottom: clamp(1.75rem, 3vw, 2.75rem); }
  .reviews-hero .eyebrow { margin-bottom: .8rem; color: var(--saddle); }
  .reviews-hero h1 { margin: 0; font-family: var(--serif); font-size: clamp(3.25rem, 5.6vw, 5.5rem); font-weight: 400; letter-spacing: -.035em; line-height: .98; text-wrap: balance; }
  .reviews-hero h1 em { color: var(--saddle); font-weight: 400; }
  .reviews-hero__intro { max-width: 39rem; margin: 1rem 0 0; font-size: 1rem; color: var(--ink); }
  .review-article { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.5fr); grid-template-areas: 'metadata quote' 'metadata actions'; column-gap: clamp(2rem, 5vw, 4.5rem); row-gap: 1.25rem; padding: clamp(2rem, 4vw, 3.5rem) 0; border-bottom: 1px solid var(--line); }
  .review-article__metadata { grid-area: metadata; min-width: 0; }
  .review-article__metadata h2 { margin: 0; font-size: 1.05rem; font-weight: 600; line-height: 1.4; }
  .review-article__source { margin: .3rem 0 0; font-size: .875rem; color: var(--ink); }
  .review-article__rating { margin: .5rem 0 0; color: var(--saddle); font-size: .9rem; letter-spacing: .1em; }
  .review-article__context { max-width: 19rem; margin: 1rem 0 0; font-size: .9375rem; color: var(--ink); line-height: 1.55; }
  .review-article__context a { text-decoration: underline; text-underline-offset: .2em; }
  .review-article__quote { grid-area: quote; min-width: 0; margin: 0; max-width: 50rem; }
  .review-article__quote p { margin: 0; font-family: var(--serif); font-size: clamp(1.5rem, 1.9vw, 1.75rem); line-height: 1.3; color: var(--ink-deep); }
  .review-article__actions { grid-area: actions; display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1.5rem; min-width: 0; }
  .review-article__actions a, .reviews-google__link { display: inline-flex; align-items: center; min-height: 2.75rem; padding-block: .5rem; font-size: .875rem; line-height: 1.5; text-decoration: underline; text-underline-offset: .25em; text-decoration-thickness: 1px; }
  .review-article__service { color: var(--ink); font-weight: 600; }
  .review-article__source-link { color: var(--saddle); }
  .review-article--featured { grid-template-columns: minmax(0, 2.65fr) minmax(0, 1fr); grid-template-areas: 'quote metadata' 'quote actions'; row-gap: 1rem; padding: clamp(2rem, 3.5vw, 3rem); margin-bottom: .5rem; border: 0; border-radius: var(--radius); background: var(--ink); color: var(--paper); }
  .review-article--featured .review-article__quote p { color: var(--paper); font-size: clamp(2.25rem, 2.9vw, 2.75rem); line-height: 1.16; }
  .review-article--featured .review-article__metadata { padding-top: .25rem; }
  .review-article--featured .review-article__source, .review-article--featured .review-article__context { color: var(--cream); }
  .review-article--featured .review-article__actions { align-self: start; flex-direction: column; align-items: flex-start; gap: .25rem; }
  .review-article--featured .review-article__service { color: var(--paper); }
  .review-article--featured .review-article__source-link { color: #e8cfa8; }
  .reviews-google { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.75rem; }
  .reviews-google h2 { margin: 0; font-size: 1rem; font-weight: 600; }
  .reviews-google p { margin: .25rem 0 0; font-size: .9375rem; color: var(--ink); }
  .reviews-google__link { color: var(--saddle); font-weight: 600; }
  .reviews-estimate { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--cream); }
  .reviews-estimate > div { max-width: 43rem; }
  .reviews-estimate .eyebrow { margin-bottom: .6rem; color: var(--saddle); }
  .reviews-estimate h2 { margin: 0; font-family: var(--serif); font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 400; line-height: 1.08; text-wrap: balance; }
  .reviews-estimate p:not(.eyebrow) { max-width: 37rem; margin: .8rem 0 0; font-size: .9375rem; color: var(--ink); }
  .reviews-estimate .button { flex-shrink: 0; }
  .reviews-page a:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
  .review-article--featured a:focus-visible { outline-color: var(--paper); }
  .reviews-page :global(.page-breadcrumbs a) { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .reviews-page :global(.page-breadcrumbs) { align-items: center; margin-bottom: .65rem; font-size: .8125rem; color: var(--ink); }
  @media (max-width: 820px) {
    .reviews-page { padding-top: 7rem; }
    .reviews-hero h1 { font-size: clamp(2.75rem, 12vw, 3.5rem); }
    .reviews-hero__intro { font-size: .9375rem; }
    .review-article { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'metadata' 'quote' 'actions'; gap: 1.1rem; padding-block: 1.75rem; }
    .review-article__context { max-width: none; margin-top: .6rem; }
    .review-article__quote p { font-size: 1.5rem; line-height: 1.3; }
    .review-article--featured { grid-template-areas: 'quote' 'metadata' 'actions'; padding: 1.25rem; border-radius: 1.25rem; }
    .review-article--featured .review-article__quote p { font-size: 1.5625rem; line-height: 1.24; }
    .review-article--featured .review-article__metadata { padding-top: .4rem; }
    .review-article--featured .review-article__actions { gap: .15rem; }
    .reviews-google, .reviews-estimate { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .reviews-estimate { padding: 1.25rem; border-radius: 1.25rem; }
    .reviews-estimate .button { max-width: 100%; }
  }
</style>
