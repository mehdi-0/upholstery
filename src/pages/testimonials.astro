---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Client Reviews | Nora's Upholstery";
const description = "Reviews from clinical, residential and commercial upholstery clients across the Greater Toronto Area.";
const googleProfileUrl = 'https://share.google/hH6pGfzI1YAUH9HLG';

// Keep review wording and the reviewer's displayed name exactly as published.
// Add `context` only when the project type, title or company relationship is verified.
const reviews = [
  {
    name: 'Dr. David Song',
    context: 'Chiropractic table restoration',
    source: 'Google review',
    url: googleProfileUrl,
    text: 'Awesome rates and beautiful workmanship for my chiropractic table. They also replaced some missing screws and cleaned up some nasty rust that I had going on with the table. Great communication as well.',
    featured: true,
  },
  {
    name: 'Gabriel',
    context: 'Medical clinic client for over 12 years',
    source: 'Google review',
    url: googleProfileUrl,
    text: "I highly recommend Nora's Upholstery for your commercial or residential needs. This business is family run and has been supporting my medical clinics for over 12 years. Shaida, is fantastic to deal with and she has great customer service, great prices and excellent turn good around times. Support our economy by supporting local business and our trades.",
  },
  {
    name: 'Irit Frid',
    context: 'Eight dining chairs renewed',
    source: 'Google review',
    url: googleProfileUrl,
    text: "I highly recommend Nora's upholstery! I can’t say enough about their excellent friendly service, from the first moment I made the contact to choosing the fabric and the final result. Nora’s upholstery did an AMAZING job renewing my 8 dining chairs, including replacing the fabric, foam, and upholstery. The job was done fast, professionally, and with a lot of care for the small details. Top Notch. Thank you, Nora.",
  },
];
---
<BaseLayout {title} {description}>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Work remembered</p>
      <h1>What clients say<br /><em>after the reveal.</em></h1>
    </div>
  </header>

  <section class="content-section reviews-section">
    <div class="shell reviews-grid">
      {reviews.map((review) => (
        <blockquote class:list={['review-card', review.featured && 'review-card--featured']}>
          <div class="review-card__source"><span class="review-card__google"><img src="/icons/google.svg" alt="" />{review.source}</span><span aria-label="5 out of 5 stars">★★★★★</span></div>
          <p>“{review.text}”</p>
          <footer><strong>{review.name}</strong><span>{review.context}</span><a href={review.url} target="_blank" rel="noopener">View on Google ↗</a></footer>
        </blockquote>
      ))}

    </div>
    <div class="shell google-review-action">
      <a class="button button--dark" href={googleProfileUrl} target="_blank" rel="noopener">View all Google reviews</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero h1 em { color: var(--saddle); font-weight: 400; }
  .reviews-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .review-card { margin: 0; padding: clamp(1.5rem,3vw,2.5rem); border-radius: var(--radius); background: var(--ink); color: #fff; }
  .review-card--featured { grid-column: 1 / -1; }
  .review-card__source { display: flex; justify-content: space-between; color: rgba(255,255,255,.55); font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; }
  .review-card__google { display: inline-flex; align-items: center; gap: .5rem; }
  .review-card__google img { width: 1rem; height: 1rem; filter: brightness(0) invert(1); opacity: .8; }
  .review-card > p { margin: clamp(1.75rem,3vw,2.5rem) 0; font-family: var(--serif); font-size: clamp(1.6rem,2.5vw,2.8rem); line-height: 1.02; }
  .review-card--featured > p { max-width: 1100px; font-size: clamp(2.15rem,3.3vw,3.65rem); line-height: .98; }
  .review-card footer { display: grid; }
  .review-card footer strong { font-size: .8rem; }
  .review-card footer span { color: rgba(255,255,255,.55); font-size: .68rem; }
  .review-card footer a { width: fit-content; margin-top: 1rem; padding-bottom: .2rem; border-bottom: 1px solid rgba(255,255,255,.5); color: rgba(255,255,255,.82); font-size: .68rem; }
  .google-review-action { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; margin-top:1.5rem; padding-top:1.5rem; border-top:1px solid var(--line); }
  .google-review-action p { max-width:560px; margin:0; color:rgba(8,30,39,.6); font-size:.78rem; }
  @media (max-width:820px) { .reviews-grid { grid-template-columns:1fr; } .review-card--featured { grid-column:auto; } .review-card > p, .review-card--featured > p { margin:2rem 0; font-size:clamp(1.75rem,8vw,2.8rem); line-height:1; } .google-review-action { display:grid; } }
</style>
