---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Return Policy | Nora's Upholstery";
const description = "Nora's Upholstery service return policy and contact information.";
---
<BaseLayout {title} {description}>
  <section class="policy-page shell">
    <header class="policy-page__header"><p class="eyebrow">Customer information</p><h1>Return policy</h1><p>Last reviewed July 22, 2026</p></header>
    <article class="policy-page__content glass">
      <h2>Work made for your piece</h2>
      <p>Every upholstery project is completed specifically for the customer and their furniture or equipment. For that reason, all completed services are final sale.</p>
      <h2>We’re here to talk</h2>
      <p>We care about the work we return to you. If you have a concern about a completed project, please get in touch with Nora’s Upholstery so we can listen, understand what happened and discuss it with you.</p>
      <p><a class="text-link" href="tel:+16479812622">Call 647 981 2622 <span>↗</span></a></p>
      <p><a class="text-link" href="mailto:norasupholstery@gmail.com">Email norasupholstery@gmail.com <span>↗</span></a></p>
    </article>
  </section>
</BaseLayout>
