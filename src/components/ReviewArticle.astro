---
import type { ProjectId } from '../data/projects';
import type { Review } from '../data/reviews';
import type { ServicePath } from '../data/servicePaths';

type Props = {
  review: Review;
  featured?: boolean;
  context?: string;
  projectContexts?: readonly { projectId: ProjectId; label: string; href: string }[];
  servicePath?: ServicePath;
  serviceLabel?: string;
};

const {
  review,
  featured = false,
  context,
  projectContexts = [],
  servicePath,
  serviceLabel,
} = Astro.props as Props;
const articleId = `review-${review.id}`;
---

<article
  class:list={['review-article', featured ? 'review-article--featured' : 'review-article--standard']}
  aria-labelledby={articleId}
  data-review-item={!featured ? '' : undefined}
>
  {featured ? (
    <>
      <blockquote class="review-article__quote"><p>{review.originalText}</p></blockquote>
      <footer class="review-article__details">
        <h2 id={articleId}>{review.reviewerDisplayName}</h2>
        <p class="review-article__rating">
          {review.rating && <span class="review-article__stars" aria-hidden="true">{'★'.repeat(review.rating)}</span>}
          {review.rating && <span class="review-article__separator" aria-hidden="true">·</span>}
          <span>{review.sourceLabel}</span>
          {review.rating && <span class="visually-hidden">{review.rating} out of 5 stars</span>}
        </p>
        {context && <p class="review-article__context">{context}</p>}
        {projectContexts.map((project) => (
          <div class="review-article__project">
            <span class="review-article__project-label">Related work</span>
            <a href={project.href} aria-label={`Related work: ${project.label}`}>
              {project.label}<span aria-hidden="true"> ↗</span>
            </a>
          </div>
        ))}
        {servicePath && serviceLabel && (
          <a class="review-article__service" href={servicePath}>{serviceLabel}<span aria-hidden="true"> ↗</span></a>
        )}
      </footer>
    </>
  ) : (
    <>
      <p class="review-article__rating">
        {review.rating && <span class="review-article__stars" aria-hidden="true">{'★'.repeat(review.rating)}</span>}
        {review.rating && <span class="review-article__separator" aria-hidden="true">·</span>}
        <span>{review.sourceLabel}</span>
        {review.rating && <span class="visually-hidden">{review.rating} out of 5 stars</span>}
      </p>
      <blockquote class="review-article__quote"><p>{review.originalText}</p></blockquote>
      <footer class="review-article__details">
        <h2 id={articleId}>{review.reviewerDisplayName}</h2>
        {context && <p class="review-article__context">{context}</p>}
        {projectContexts.map((project) => (
          <div class="review-article__project">
            <span class="review-article__project-label">Related work</span>
            <a href={project.href} aria-label={`Related work: ${project.label}`}>
              {project.label}<span aria-hidden="true"> ↗</span>
            </a>
          </div>
        ))}
        {servicePath && serviceLabel && (
          <a class="review-article__service" href={servicePath}>{serviceLabel}<span aria-hidden="true"> ↗</span></a>
        )}
      </footer>
    </>
  )}
</article>

<style>
  .review-article { min-width: 0; }
  .review-article__rating { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem; margin: 0 0 1rem; color: var(--ink); font-size: .8125rem; line-height: 1.4; }
  .review-article__stars { color: var(--saddle); letter-spacing: .09em; }
  .review-article__separator { color: var(--brass); }
  .review-article__quote { margin: 0; }
  .review-article__quote p { margin: 0; color: var(--ink-deep); font-family: var(--serif); font-size: 1.125rem; line-height: 1.45; }
  .review-article__details { display: grid; justify-items: start; gap: .25rem; margin-top: 1.1rem; }
  .review-article__details h2 { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.45; }
  .review-article__context { margin: 0; color: var(--ink); font-size: .875rem; line-height: 1.5; }
  .review-article__project { display: grid; justify-items: start; gap: .15rem; margin-top: .6rem; color: var(--ink); font-size: .875rem; line-height: 1.5; }
  .review-article__project-label { color: var(--saddle); font-size: .65rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .review-article__project a { text-decoration: underline; text-decoration-color: rgba(139,98,72,.45); text-underline-offset: .2em; }
  .review-article__project a span, .review-article__service span { white-space: nowrap; }
  .review-article__service { display: inline-flex; align-items: baseline; min-height: 2.75rem; margin-top: .35rem; color: var(--ink); font-size: .875rem; font-weight: 600; line-height: 1.5; text-decoration: underline; text-underline-offset: .22em; }

  .review-article--featured { display: grid; grid-template-columns: minmax(0, 2.65fr) minmax(0, 1fr); grid-template-areas: 'quote details'; column-gap: clamp(2rem, 5vw, 4.5rem); row-gap: 1rem; padding: clamp(2rem, 3.5vw, 3rem); margin-bottom: .5rem; border: 0; border-radius: var(--radius); background: var(--ink); color: var(--paper); }
  .review-article--featured .review-article__rating { margin: .25rem 0 .15rem; color: var(--cream); }
  .review-article--featured .review-article__stars { color: #e8cfa8; }
  .review-article--featured .review-article__quote { grid-area: quote; }
  .review-article--featured .review-article__quote p { color: var(--paper); font-size: clamp(2.25rem, 2.9vw, 2.75rem); line-height: 1.16; }
  .review-article--featured .review-article__details { grid-area: details; align-self: start; gap: .4rem; margin-top: 0; color: var(--paper); }
  .review-article--featured .review-article__details h2 { font-size: 1.05rem; }
  .review-article--featured .review-article__context { color: var(--cream); }
  .review-article--featured .review-article__service { color: var(--paper); }
  .review-article--featured :focus-visible { outline-color: var(--paper); }

  .visually-hidden { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important; }

  @media (min-width: 821px) {
    .review-article--standard { padding-block: 1.5rem; border-top: 1px solid var(--line); }
    .review-article--standard .review-article__rating { margin-bottom: .8rem; }
    .review-article--standard .review-article__details { margin-top: 1rem; }
    .review-article--standard .review-article__quote p { font-size: 1.25rem; }
  }

  @media (max-width: 820px) {
    .review-article--featured { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'quote' 'details'; gap: .75rem; padding: 1.35rem; border-radius: 1.25rem; }
    .review-article--featured .review-article__quote p { font-size: 1.5625rem; line-height: 1.24; }
    .review-article--featured .review-article__details { margin: 0; }
    .review-article--standard .review-article__quote p { max-width: 68ch; }
  }
</style>
