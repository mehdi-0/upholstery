---
type Photo = { src: string; label: string; note: string; alt: string; position?: string };
const { photos, heading = 'Photo slots ready for your work' } = Astro.props as { photos: Photo[]; heading?: string };
---
<section class="photo-strip" aria-label={heading} data-photo-strip>
  <div class="photo-strip__header">
    <p class="photo-strip__heading">{heading}</p>
    {photos.length > 1 && (
      <div class="photo-strip__controls" aria-label="Photo controls">
        <button type="button" aria-label="Show previous photo" data-photo-strip-prev>&larr;</button>
        <button type="button" aria-label="Show next photo" data-photo-strip-next>&rarr;</button>
      </div>
    )}
  </div>
  <div
    class:list={['photo-strip__grid', { 'photo-strip__grid--three': photos.length === 3 }]}
    data-photo-strip-rail
    tabindex={photos.length > 1 ? '0' : undefined}
    role={photos.length > 1 ? 'region' : undefined}
    aria-label={photos.length > 1 ? `${heading}. Swipe or use the arrow keys to view each photo.` : undefined}
  >
    {photos.map((photo, index) => (
      <figure class="photo-slot" role="group" aria-label={`${index + 1} of ${photos.length}: ${photo.label}`}>
        <div class="photo-slot__fallback" aria-hidden="true"><span>{photo.label}</span><small>{photo.note}</small></div>
        <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" style={photo.position ? `object-position: ${photo.position}` : undefined} onerror="this.hidden=true" />
        <figcaption>{photo.label}</figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .photo-strip { margin-block: clamp(1.5rem, 3.5vw, 3rem); }
  .photo-strip__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; }
  .photo-strip__heading { margin: 0; color: rgba(8,30,39,.5); font-size: .62rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
  .photo-strip__controls { display: none; gap: .45rem; }
  .photo-strip__controls button { display: grid; width: 2.65rem; height: 2.65rem; padding: 0; place-items: center; border: 1px solid rgba(8,30,39,.2); border-radius: 50%; color: var(--ink); background: rgba(255,255,255,.56); font: inherit; cursor: pointer; }
  .photo-strip__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .photo-strip__grid--three { grid-template-columns: 1.15fr .85fr .85fr; }
  .photo-slot { position: relative; min-height: clamp(230px, 27vw, 360px); margin: 0; border: 1px solid rgba(255,255,255,.58); border-radius: 1.35rem; background: var(--ink); box-shadow: 0 20px 45px rgba(5,21,27,.11); overflow: hidden; }
  .photo-slot::after { content: ''; position: absolute; z-index: 2; inset: auto 0 0; height: 45%; pointer-events: none; background: linear-gradient(transparent, rgba(3,17,23,.64)); }
  .photo-slot__fallback { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: end; padding: 1.2rem; color: rgba(255,255,255,.78); background: radial-gradient(circle at 72% 25%, rgba(183,138,71,.3), transparent 25%), repeating-linear-gradient(98deg, rgba(255,255,255,.06) 0 1px, transparent 1px 7px), linear-gradient(145deg,#173e4b,#0a2029); }
  .photo-slot__fallback span { font-family: var(--serif); font-size: 1.8rem; line-height: 1; }
  .photo-slot__fallback small { margin-top: .5rem; color: rgba(255,255,255,.48); font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; }
  .photo-slot img { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photo-slot figcaption { position: absolute; z-index: 3; right: 1rem; bottom: .9rem; left: 1rem; color: #fff; font-size: .67rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 820px) {
    .photo-strip__controls { display: flex; }
    .photo-strip__grid, .photo-strip__grid--three { display: flex; width: calc(100% + .6rem); gap: .7rem; margin-right: -.6rem; padding-right: .6rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-padding-inline: 0 .6rem; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .photo-strip__grid::-webkit-scrollbar { display: none; }
    .photo-slot { flex: 0 0 82vw; min-height: 270px; scroll-snap-align: start; }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-photo-strip]').forEach((strip) => {
    const rail = strip.querySelector<HTMLElement>('[data-photo-strip-rail]');
    const previous = strip.querySelector<HTMLButtonElement>('[data-photo-strip-prev]');
    const next = strip.querySelector<HTMLButtonElement>('[data-photo-strip-next]');
    if (!rail) return;

    const cards = Array.from(rail.querySelectorAll<HTMLElement>('.photo-slot'));
    const cardDistance = () => {
      const firstCard = cards[0];
      if (!firstCard) return rail.clientWidth;
      const styles = window.getComputedStyle(rail);
      const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
      return firstCard.getBoundingClientRect().width + gap;
    };
    const scrollToCard = (index: number) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, index))];
      card?.scrollIntoView({
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'start',
      });
    };
    const currentIndex = () => Math.round(rail.scrollLeft / Math.max(1, cardDistance()));

    previous?.addEventListener('click', () => scrollToCard(currentIndex() - 1));
    next?.addEventListener('click', () => scrollToCard(currentIndex() + 1));
    rail.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'Home') scrollToCard(0);
      else if (event.key === 'End') scrollToCard(cards.length - 1);
      else scrollToCard(currentIndex() + (event.key === 'ArrowRight' ? 1 : -1));
    });
  });
</script>
