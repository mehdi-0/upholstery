---
interface Props {
  signals: readonly [string, string];
}

const { signals } = Astro.props;
---

<div class="service-editorial-hero">
  <div class="service-editorial-hero__art" aria-hidden="true">
    <span class="service-editorial-hero__contour service-editorial-hero__contour--tall">
      <svg class="service-editorial-hero__seam" viewBox="0 0 300 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M 43 328 C 24 264 19 179 34 113 C 43 72 60 48 87 35" vector-effect="non-scaling-stroke" />
      </svg>
    </span>
    <span class="service-editorial-hero__material-edge"></span>
    <span class="service-editorial-hero__contour service-editorial-hero__contour--lower"></span>
  </div>
  <ul class="service-editorial-hero__signals">
    {signals.map((signal) => <li>{signal}</li>)}
  </ul>
</div>

<style>
  .service-editorial-hero {
    --editorial-signal-region: 5.25rem;
    position: relative;
    min-width: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: clamp(1.2rem, 2.8vw, 2rem);
    background:
      radial-gradient(ellipse at 20% 8%, rgba(247, 243, 235, .055), transparent 65%),
      linear-gradient(140deg, var(--ink), var(--ink-deep));
    box-shadow: inset 0 1px 0 rgba(247, 243, 235, .12), 0 24px 60px rgba(5, 21, 27, .15);
  }

  .service-editorial-hero__art {
    position: absolute;
    inset: 0 0 var(--editorial-signal-region);
    overflow: hidden;
    pointer-events: none;
  }

  .service-editorial-hero__contour,
  .service-editorial-hero__material-edge {
    position: absolute;
    display: block;
  }

  .service-editorial-hero__contour--tall {
    top: -24%;
    left: 39%;
    width: 64%;
    height: 134%;
    border-radius: 44% 34% 24% 38%;
    background:
      linear-gradient(115deg, rgba(247, 243, 235, .13), transparent 40%, rgba(8, 30, 39, .3)),
      var(--ink);
    box-shadow: inset 1px 1px 0 rgba(247, 243, 235, .16), inset -9px -5px 18px rgba(8, 30, 39, .16), -12px 16px 24px rgba(0, 0, 0, .12);
    transform: rotate(20deg);
  }

  .service-editorial-hero__contour--lower,
  .service-editorial-hero__material-edge {
    top: 49%;
    left: -10%;
    width: 101%;
    height: 77%;
    border-radius: 47% 43% 20% 14%;
    transform: rotate(-13deg);
  }

  .service-editorial-hero__material-edge {
    margin-top: -4px;
    margin-left: -3px;
    background: linear-gradient(120deg, rgba(238, 230, 216, .6), rgba(238, 230, 216, .12) 70%);
  }

  .service-editorial-hero__contour--lower {
    background:
      linear-gradient(165deg, rgba(247, 243, 235, .085), transparent 45%, rgba(8, 30, 39, .3)),
      var(--ink);
    box-shadow: inset 0 1px 0 rgba(247, 243, 235, .16), 0 -10px 22px rgba(8, 30, 39, .24);
  }

  .service-editorial-hero__seam {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    fill: none;
    stroke: var(--brass);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: .65;
  }

  .service-editorial-hero__signals {
    position: absolute;
    inset-inline: 1.5rem;
    bottom: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .5rem 1rem;
    margin: 0;
    padding: .85rem 0 0;
    border-top: 1px solid rgba(238, 230, 216, .24);
    color: var(--paper);
    font-family: var(--sans);
    font-size: .8125rem;
    line-height: 1.4;
    list-style: none;
  }

  .service-editorial-hero__signals li {
    min-width: 0;
  }

  @media (max-width: 820px) {
    .service-editorial-hero {
      --editorial-signal-region: 4.5rem;
      aspect-ratio: 5 / 4;
    }

    .service-editorial-hero__contour--tall {
      top: -30%;
      left: 51%;
      width: 78%;
      height: 145%;
      transform: rotate(16deg);
    }

    .service-editorial-hero__contour--lower {
      top: 48%;
      left: -22%;
      width: 118%;
      height: 80%;
      border-radius: 42% 38% 18% 12%;
      transform: rotate(-10deg);
    }

    .service-editorial-hero__material-edge {
      display: none;
    }

    .service-editorial-hero__signals {
      inset-inline: 1.125rem;
      bottom: .875rem;
      grid-template-columns: 1fr;
      gap: .25rem;
      padding-top: .65rem;
    }
  }
</style>
