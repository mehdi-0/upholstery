---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ServiceFaq from './ServiceFaq.astro';
import ServiceProject from './ServiceProject.astro';
import ServiceEditorialHero from './ServiceEditorialHero.astro';
import { absoluteUrl, organizationSchema, phoneDisplay, phoneHref, serviceSchema, websiteSchema } from '../data/business';
import { getServiceHeroImage, getServiceProject } from '../data/evidence';
import type { ServiceDetail } from '../data/serviceDetails';

const { data } = Astro.props as { data: ServiceDetail };
const origin = (Astro.site ?? Astro.url).origin;
const pageUrl = absoluteUrl(origin, data.path);
const pageId = `${pageUrl}#webpage`;
const serviceId = `${pageUrl}#service`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const faqId = `${pageUrl}#faq`;
const faqDomId = `${data.path.replace(/^\/+|\/+$/g, '').replaceAll('/', '-')}-faq`;
const heroImage = getServiceHeroImage(data);
const serviceProject = getServiceProject(data);
const socialImageProps = heroImage
  ? { seoImage: heroImage.src, seoImageAlt: heroImage.alt }
  : {};
const structuredData = [
  organizationSchema(origin),
  websiteSchema(origin),
  {
    '@type': 'WebPage',
    '@id': pageId,
    url: pageUrl,
    name: data.title,
    description: data.description,
    inLanguage: 'en-CA',
    isPartOf: { '@id': absoluteUrl(origin, '/#website') },
    breadcrumb: { '@id': breadcrumbId },
    mainEntity: { '@id': serviceId },
    hasPart: { '@id': faqId },
  },
  serviceSchema(origin, {
    name: data.heading,
    description: data.intro.join(' '),
    path: data.path,
    serviceTypes: data.serviceTypes,
    areas: data.areas,
  }),
  {
    '@type': 'FAQPage',
    '@id': faqId,
    url: pageUrl,
    about: { '@id': serviceId },
    mainEntity: data.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Medical & Chiropractic', href: '/services/medical/' },
  { name: data.heading },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  {...socialImageProps}
  structuredData={structuredData}
>
  <div class="service-evidence shell">
    <header class="service-evidence__hero">
      <div class="service-evidence__hero-copy">
        <Breadcrumbs items={breadcrumbs} schemaId={breadcrumbId} compact />
        <p class="kicker-gold">{data.eyebrow}</p>
        <h1>{data.heading}</h1>
        <div class="service-evidence__intro">{data.intro.map((paragraph) => <p>{paragraph}</p>)}</div>
        <div class="service-evidence__actions">
          <a class="button button--dark" href="/contact#estimate-form">Request an Estimate</a>
          <a class="text-link" href={phoneHref}>Call Nora’s <span aria-hidden="true">↗</span><span class="visually-hidden"> at {phoneDisplay}</span></a>
        </div>
      </div>
      {data.hero.variant === 'editorial' ? (
        <ServiceEditorialHero signals={data.hero.signals} />
      ) : heroImage && (
      <figure class="service-evidence__hero-image">
        <div class="service-evidence__hero-media">
          <img
            src={heroImage.src}
            srcset={heroImage.srcset}
            sizes={heroImage.sizes}
            width={heroImage.width}
            height={heroImage.height}
            alt={heroImage.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        {heroImage.caption && <figcaption>{heroImage.caption}</figcaption>}
      </figure>
      )}
    </header>

    <section class="service-evidence__details" aria-labelledby="service-details-heading">
      <header class="service-evidence__details-heading">
        <p class="eyebrow">Upholstery scope and materials</p>
        <h2 id="service-details-heading">{data.details.heading}</h2>
      </header>
      <div class="service-evidence__details-columns">
        <section aria-labelledby="service-scope-heading">
          <h3 id="service-scope-heading">{data.details.scopeHeading}</h3>
          <p>{data.details.scopeCopy}</p>
          <ul>
            {data.details.scopeItems.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section aria-labelledby="service-materials-heading">
          <h3 id="service-materials-heading">{data.details.materialsHeading}</h3>
          <p>{data.details.materialsCopy}</p>
          <h4>{data.details.foamHeading}</h4>
          <p>{data.details.foamCopy}</p>
          <h4>{data.details.pickupHeading}</h4>
          <p>{data.details.workflowCopy}</p>
        </section>
      </div>
    </section>

    <ServiceProject project={serviceProject} />
    <ServiceFaq heading={data.faqHeading} items={data.faq} id={faqDomId} />

    <section class="service-evidence__next" aria-labelledby="getting-started-heading">
      <div class="service-evidence__related">
        <p class="eyebrow">More medical upholstery</p>
        <nav aria-label="Related medical upholstery services">
          {data.related.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
        </nav>
      </div>
      <div class="service-evidence__closing glass-dark">
        <div class="service-evidence__closing-copy">
          <p class="eyebrow eyebrow--light">A clear place to start</p>
          <h2 id="getting-started-heading">{data.gettingStarted.heading}</h2>
        </div>
        <ol>
          {data.gettingStarted.steps.map((step) => <li>{step}</li>)}
        </ol>
        <div class="service-evidence__closing-actions">
          <a class="button button--light" href="/contact#estimate-form">Send Photos for an Estimate</a>
          <a class="text-link text-link--light" href={phoneHref}>Call Nora’s <span aria-hidden="true">↗</span><span class="visually-hidden"> at {phoneDisplay}</span></a>
        </div>
        <p class="service-evidence__policy">{data.policyCopy ?? 'Pickup and delivery are available across the GTA. Pricing depends on location and project.'}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .service-evidence {
    --service-evidence-chapter-gap: clamp(3.5rem, 5vw, 4.5rem);
    --service-evidence-content-gap: clamp(1.5rem, 2vw, 2rem);
    --service-evidence-group-gap: clamp(1.25rem, 1.7vw, 1.5rem);
    --service-evidence-copy-gap: .625rem;
    --service-evidence-label-gap: .625rem;
    padding-bottom: clamp(2.5rem, 5vw, 4.8rem);
  }

  .service-evidence :global(.eyebrow) {
    margin: 0;
  }

  .service-evidence__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(20rem, .98fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block-start: clamp(7.5rem, 8vw, 8rem);
  }

  .service-evidence__hero-copy {
    min-width: 0;
  }

  .service-evidence__hero h1 {
    margin: .8rem 0 1.15rem;
    font-family: var(--serif);
    font-size: clamp(3.7rem, 6vw, 6.3rem);
    font-weight: 400;
    line-height: .88;
    letter-spacing: -.045em;
    text-wrap: balance;
  }

  .service-evidence__intro {
    display: grid;
    gap: var(--service-evidence-copy-gap);
    max-width: 39rem;
    color: rgba(8, 30, 39, .72);
    font-size: clamp(.94rem, 1.25vw, 1.08rem);
  }

  .service-evidence__intro p {
    margin: 0;
  }

  .service-evidence__intro p + p {
    margin-top: 0;
  }

  .service-evidence__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .9rem 1.4rem;
    margin-top: 1.4rem;
  }

  .service-evidence__actions .button {
    min-height: 3.3rem;
  }

  .service-evidence__actions .text-link,
  .service-evidence__closing-actions .text-link {
    min-height: 3rem;
    align-items: center;
  }

  .service-evidence__hero-image {
    min-width: 0;
    margin: 0;
  }

  .service-evidence__hero-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: clamp(1.2rem, 2.8vw, 2rem);
    background: rgba(16, 47, 61, .045);
    box-shadow: 0 24px 60px rgba(5, 21, 27, .15);
  }

  .service-evidence__hero-image img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-evidence__hero-image figcaption {
    margin-top: .55rem;
    color: rgba(8, 30, 39, .56);
    font-size: .7rem;
  }

  .service-evidence__details {
    position: relative;
    display: grid;
    gap: var(--service-evidence-content-gap);
    padding-block-start: var(--service-evidence-chapter-gap);
  }

  .service-evidence__details::before,
  .service-evidence__next::before {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--service-evidence-chapter-gap) / 2);
    border-top: 1px solid var(--line);
    content: '';
  }

  .service-evidence__details-heading {
    display: grid;
    gap: var(--service-evidence-label-gap);
    max-width: 48rem;
  }

  .service-evidence__details-heading h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 4.7vw, 4.8rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.04em;
  }

  .service-evidence__details-columns {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
    gap: var(--service-evidence-group-gap);
  }

  .service-evidence__details-columns section {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--service-evidence-copy-gap);
  }

  .service-evidence__details-columns section + section {
    padding-left: var(--service-evidence-group-gap);
    border-left: 1px solid var(--line);
  }

  .service-evidence__details-columns h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 2.6vw, 2.65rem);
    font-weight: 400;
    line-height: 1;
  }

  .service-evidence__details-columns p {
    max-width: 44rem;
    margin: 0;
    color: rgba(8, 30, 39, .72);
    font-size: .9rem;
  }

  .service-evidence__details-columns h4 {
    margin: calc(var(--service-evidence-group-gap) - var(--service-evidence-copy-gap)) 0 0;
    font-size: .82rem;
    font-weight: 700;
  }

  .service-evidence__details-columns ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .35rem 1rem;
    margin: 0;
    padding: .75rem 0;
    border-block: 1px solid var(--line);
    list-style: none;
  }

  .service-evidence__details-columns li {
    position: relative;
    padding-left: .9rem;
    color: rgba(8, 30, 39, .78);
    font-size: .82rem;
  }

  .service-evidence__details-columns li::before {
    position: absolute;
    left: 0;
    color: var(--brass);
    content: '·';
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .service-evidence__details-columns .service-evidence__note {
    font-size: .78rem;
  }

  .service-evidence__next {
    position: relative;
    padding-block-start: var(--service-evidence-chapter-gap);
  }

  .service-evidence__related {
    display: grid;
    gap: var(--service-evidence-label-gap);
  }

  .service-evidence__related nav {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem 1.4rem;
    margin-top: 0;
  }

  .service-evidence__related nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: .45rem;
    padding-block: .3rem;
    border-bottom: 1px solid rgba(139, 98, 72, .34);
    font-size: .82rem;
    font-weight: 600;
  }

  .service-evidence__related nav a span {
    color: var(--saddle);
    font-size: .72rem;
  }

  .service-evidence__closing {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(17rem, .9fr);
    grid-template-areas:
      'copy steps'
      'actions policy';
    align-items: start;
    gap: .85rem 3rem;
    margin-top: var(--service-evidence-group-gap);
    padding: clamp(1.5rem, 4vw, 3.2rem);
    border-radius: clamp(1.3rem, 2.5vw, 2rem);
  }

  .service-evidence__closing-copy {
    grid-area: copy;
  }

  .service-evidence__closing-copy h2 {
    max-width: 30rem;
    margin: var(--service-evidence-label-gap) 0 0;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 4.5vw, 4.25rem);
    font-weight: 400;
    line-height: .94;
    letter-spacing: -.04em;
  }

  .service-evidence__closing ol {
    grid-area: steps;
    margin: 0;
    padding-left: 1.25rem;
    color: rgba(255, 255, 255, .86);
    font-size: .83rem;
  }

  .service-evidence__closing li {
    padding: .3rem 0 .3rem .3rem;
  }

  .service-evidence__closing li::marker {
    color: #dfc49e;
  }

  .service-evidence__closing-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .9rem 1.3rem;
    margin: 0;
  }

  .service-evidence__closing-actions .button {
    text-align: center;
  }

  .service-evidence__policy {
    grid-area: policy;
    align-self: center;
    margin: 0;
    color: rgba(255, 255, 255, .62);
    font-size: .7rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 820px) {
    .service-evidence {
      --service-evidence-chapter-gap: clamp(2.25rem, 5vw, 2.75rem);
      --service-evidence-content-gap: 1.25rem;
      --service-evidence-group-gap: 1.125rem;
      --service-evidence-copy-gap: .5rem;
      --service-evidence-label-gap: .5rem;
    }

    .service-evidence__hero {
      grid-template-columns: 1fr;
      gap: 1.8rem;
      padding-block-start: 7.5rem;
    }

    .service-evidence__hero-media {
      aspect-ratio: 5 / 4;
    }

    .service-evidence__hero h1 {
      max-width: 40rem;
      font-size: clamp(2.65rem, 10.5vw, 4.6rem);
      line-height: .91;
    }

    .service-evidence__intro {
      max-width: 42rem;
      font-size: .95rem;
    }

    .service-evidence__details-heading h2 {
      font-size: clamp(2.2rem, 8vw, 3rem);
    }

    .service-evidence__details-columns {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .service-evidence__details-columns section + section {
      padding: var(--service-evidence-group-gap) 0 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .service-evidence__details-columns h3 {
      font-size: clamp(1.4rem, 5.4vw, 1.7rem);
    }

    .service-evidence__details-columns ul {
      border-bottom: 0;
    }

    .service-evidence__closing {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'steps'
        'actions'
        'policy';
      gap: .65rem;
      padding: 1.5rem;
    }

    .service-evidence__closing ol {
      margin: 0;
      line-height: 1.4;
    }

    .service-evidence__closing li {
      padding-block: .2rem;
    }

    .service-evidence__closing-copy h2 {
      margin-top: var(--service-evidence-copy-gap);
      font-size: clamp(2rem, 7.5vw, 2.6rem);
      line-height: .98;
    }

    .service-evidence__policy {
      align-self: start;
    }
  }

  @media (max-width: 420px) {
    .service-evidence__hero h1 {
      font-size: clamp(2.5rem, 11.8vw, 3.15rem);
    }

    .service-evidence__actions {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
      gap: .6rem;
    }

    .service-evidence__actions .button {
      padding-inline: .65rem;
      font-size: .75rem;
    }

    .service-evidence__actions .text-link {
      justify-content: center;
      gap: .25rem;
      font-size: .78rem;
    }

    .service-evidence__details-columns ul {
      grid-template-columns: 1fr;
    }

    .service-evidence__related nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: .3rem .7rem;
    }

    .service-evidence__closing {
      padding: 1.25rem;
    }

    .service-evidence__closing-actions {
      align-items: stretch;
      flex-direction: column;
      gap: .35rem;
    }

    .service-evidence__closing-actions .button {
      width: 100%;
    }
  }
</style>
