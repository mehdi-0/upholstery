---
import type { ServiceFaq } from '../data/serviceDetails';

const { heading, items, id = 'service-faq' } = Astro.props as {
  heading: string;
  items: ServiceFaq[];
  id?: string;
};
---

<section class="service-faq" aria-labelledby={`${id}-heading`}>
  <div class="service-faq__intro">
    <p class="eyebrow">Common questions</p>
    <h2 id={`${id}-heading`}>{heading}</h2>
  </div>
  <div class="service-faq__items">
    {items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .service-faq {
    position: relative;
    display: grid;
    grid-template-columns: minmax(14rem, .72fr) minmax(0, 1.28fr);
    gap: var(--service-evidence-content-gap, 1.75rem);
    padding-block-start: var(--service-evidence-chapter-gap, clamp(3.5rem, 5vw, 4.5rem));
  }

  .service-faq::before {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--service-evidence-chapter-gap, clamp(3.5rem, 5vw, 4.5rem)) / 2);
    border-top: 1px solid var(--line);
    content: '';
  }

  .service-faq__intro {
    display: grid;
    align-content: start;
    gap: var(--service-evidence-label-gap, .625rem);
  }

  .service-faq__intro h2 {
    max-width: 22rem;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 3.6vw, 3.8rem);
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.035em;
  }

  .service-faq__items details {
    border-top: 1px solid var(--line);
  }

  .service-faq__items details:last-child {
    border-bottom: 1px solid var(--line);
  }

  .service-faq__items summary {
    position: relative;
    min-height: 3.5rem;
    padding: 1rem 2.5rem 1rem 0;
    cursor: pointer;
    font-size: .94rem;
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
  }

  .service-faq__items summary::-webkit-details-marker {
    display: none;
  }

  .service-faq__items summary::after {
    position: absolute;
    top: .85rem;
    right: .25rem;
    content: '+';
    color: var(--saddle);
    font-size: 1.25rem;
    font-weight: 400;
  }

  .service-faq__items details[open] summary::after {
    content: '−';
  }

  .service-faq__items details p {
    max-width: 45rem;
    margin: 0;
    padding: 0 2.5rem 1.2rem 0;
    color: rgba(8, 30, 39, .7);
    font-size: .88rem;
  }

  @media (max-width: 820px) {
    .service-faq {
      grid-template-columns: 1fr;
      gap: var(--service-evidence-content-gap, 1.25rem);
      padding-block-start: var(--service-evidence-chapter-gap, 2.5rem);
    }

    .service-faq::before {
      top: calc(var(--service-evidence-chapter-gap, 2.5rem) / 2);
    }

    .service-faq__intro h2 {
      max-width: 24rem;
      font-size: clamp(2.1rem, 8vw, 3rem);
    }

    .service-faq__items summary {
      padding-block: 1.05rem;
      font-size: .9rem;
    }
  }
</style>
