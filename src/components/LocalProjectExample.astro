---
import { getProjectImage, type Project } from '../data/projects';
import { ourWorkProjectIds } from '../data/evidenceCuration';

const { project } = Astro.props as { project: Project };
const presentation = project.ourWorkPresentation;
if (!presentation) throw new Error(`Local project ${project.id} is missing presentation metadata`);

const after = getProjectImage(project.id, 'after');
const facts = project.facts.filter((fact) => ['equipment', 'work'].includes(fact.key));
const projectHref = ourWorkProjectIds.includes(project.id) ? `/before-after/#${project.id}` : undefined;
---

<article class="local-project glass" aria-labelledby={`${project.id}-local-heading`}>
  <figure class="local-project__image">
    <img src={after.src} srcset={after.srcset} sizes="(max-width: 820px) calc(100vw - 2rem), 34vw" width={after.width} height={after.height} alt={after.alt} loading="lazy" decoding="async" />
  </figure>
  <div class="local-project__copy">
    <p class="eyebrow">Verified clinic example</p>
    <h3 id={`${project.id}-local-heading`}>{project.title}</h3>
    <p>{presentation.description}</p>
    <dl>
      {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
    </dl>
    <nav aria-label="Related project information">
      {projectHref && <a href={projectHref}>See the project photos <span aria-hidden="true">↗</span></a>}
      {presentation.serviceLink && <a href={presentation.serviceLink.path}>{presentation.serviceLink.label} <span aria-hidden="true">↗</span></a>}
    </nav>
  </div>
</article>

<style>
  .local-project {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .local-project__image {
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    border-radius: 1rem;
    background: rgba(16, 47, 61, .045);
  }

  .local-project__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .local-project__copy h3 {
    margin: .5rem 0 .75rem;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 400;
    line-height: 1;
  }

  .local-project__copy > p:not(.eyebrow) {
    max-width: 38rem;
    color: rgba(8, 30, 39, .7);
  }

  .local-project dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem 1.25rem;
    margin: 1rem 0;
  }

  .local-project dt {
    margin-bottom: .2rem;
    color: rgba(8, 30, 39, .58);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .local-project dd { margin: 0; font-size: .84rem; line-height: 1.4; }
  .local-project nav { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin-top: 1.1rem; }
  .local-project nav a { font-size: .78rem; font-weight: 600; text-decoration: underline; text-decoration-color: rgba(139, 98, 72, .48); text-underline-offset: .2em; }

  @media (max-width: 820px) {
    .local-project { grid-template-columns: 1fr; }
  }
</style>
