---
const {
  title = "Nora's Upholstery",
  description = "Professional Upholstery for Clinics, Homes & Hospitality in the Greater Toronto Area.",
  seoImage = '/logo.png'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/src/styles/global.css" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={seoImage} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-white/70 backdrop-blur sticky top-0 z-20 border-b">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo.png" alt="Nora's Upholstery logo" class="h-10 w-auto rounded-md shadow-sm" />
          <span class="font-semibold">Nora's Upholstery</span>
        </a>
        <nav class="flex items-center gap-6 text-sm">
          <a href="/services" class="hover:underline">Services</a>
          <a href="/about" class="hover:underline">About</a>
          <a href="/contact" class="hover:underline">Contact</a>
          <a href="/contact#quote" class="btn-primary">Get a Quote</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-gray-100 border-t">
      <div class="max-w-6xl mx-auto px-4 py-10 grid md:grid-cols-3 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <img src="/logo.png" class="h-10 w-10 rounded-md" alt="Logo" />
            <div class="font-semibold">Nora's Upholstery</div>
          </div>
          <p class="text-sm">Serving the Greater Toronto Area with professional upholstery for medical, fitness, hospitality and home furniture.</p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">Contact</h3>
          <p class="text-sm">Phone: <a href="tel:+16479812622" class="underline">647-981-2622</a></p>
          <p class="text-sm">Email: <a class="underline" href="mailto:shaida.nora@gmail.com">shaida.nora@gmail.com</a></p>
          <p class="text-sm">Richmond Hill, Ontario</p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">Areas We Cover</h3>
          <p class="text-sm">Toronto, Richmond Hill, Vaughan, Markham, Mississauga, Oak Ridges, Newmarket, King</p>
        </div>
      </div>
      <div class="text-xs text-center py-4 border-t bg-white">© {new Date().getFullYear()} Nora's Upholstery</div>
    </footer>
  </body>
</html>
