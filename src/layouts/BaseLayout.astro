---
import '../styles/global.css';
import '../styles/mobile.css';
import { business, organizationSchema, travelContact, websiteSchema, whatsappUrl } from '../data/business';

const {
  title = "Nora's Upholstery",
  description = "Precision upholstery for clinics, homes and hospitality across the Greater Toronto Area.",
  seoImage,
  includeSiteSchema = false,
  structuredData = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteOrigin = (Astro.site ?? Astro.url).origin;
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site).toString() : undefined;
const socialImage = seoImage ? new URL(seoImage, siteOrigin).toString() : undefined;
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaGraph = [
  ...(includeSiteSchema ? [organizationSchema(siteOrigin), websiteSchema(siteOrigin)] : []),
  ...pageStructuredData,
];
const googleProfileUrl = business.googleProfileUrl;
const instagramUrl = business.instagramUrl;
const facebookUrl = business.facebookUrl;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/before-after', label: 'Our Work' },
  { href: '/testimonials', label: 'Reviews' },
  { href: '/service-areas', label: 'Service Areas' },
  { href: '/about', label: 'Our Story' },
  { href: '/contact', label: 'Contact' },
];
const serviceItems = [
  { href: '/services/dental', label: 'Dental' },
  { href: '/services/medical', label: 'Medical & Chiropractic' },
  { href: '/services/residential', label: 'Residential & Outdoor' },
  { href: '/services/commercial', label: 'Commercial' },
];
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102f3d" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/webp" href="/logo-site.webp" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nora's Upholstery" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content="Nora's Upholstery craftsmanship" />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {schemaGraph.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph })}
      />
    )}
  </head>
  <body class:list={{ 'travel-contact-active': travelContact.enabled, 'has-mobile-actions': true }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

    {travelContact.enabled && (
      <aside class="travel-contact" aria-label="Temporary contact information">
        <span>{travelContact.notice}</span>
        <a href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${business.email}`}>Email</a>
      </aside>
    )}

    <header class="site-header" data-header>
      <div class="shell">
        <div class="nav-glass">
          <a href="/" class="brand" aria-label="Nora's Upholstery home">
            <img src="/logo-site.webp" width="52" height="52" alt="" decoding="async" />
            <span class="brand-type"><strong>Nora's</strong><small>Upholstery</small></span>
          </a>

          <nav class="desktop-nav" aria-label="Primary navigation">
            <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
            <div class="desktop-subnav" data-desktop-subnav>
              <span class="desktop-subnav__trigger">
                <a href="/services" aria-current={isActive('/services') ? 'page' : undefined}>Services</a>
                <button type="button" aria-label="Show service links" aria-expanded="false" aria-controls="desktop-services" data-desktop-services-toggle><i aria-hidden="true"></i></button>
              </span>
              <div class="desktop-subnav__menu" id="desktop-services">
                {serviceItems.map((item) => <a href={item.href}><span>{item.label}</span><small>Explore ↗</small></a>)}
              </div>
            </div>
            {navItems.slice(1).map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
          </nav>

          {travelContact.enabled
            ? <a class="header-cta" href={whatsappUrl} target="_blank" rel="noopener">Message on WhatsApp</a>
            : <a class="header-cta" href="tel:+16479812622">Call 647 981 2622</a>
          }
          <button class="menu-trigger" type="button" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
            <span>Menu</span><i aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </header>

    <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
      <div class="mobile-menu__backdrop" data-menu-close></div>
      <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Navigation menu">
        <div class="mobile-menu__head">
          <span>Navigation</span>
          <button type="button" class="menu-close" data-menu-close>Close</button>
        </div>
        <nav aria-label="Mobile navigation">
          <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home <span>01</span></a>
          <div class="mobile-subnav" data-mobile-subnav>
            <div class="mobile-subnav__row">
              <a href="/services" aria-current={isActive('/services') ? 'page' : undefined}>Services <span>02</span></a>
              <button type="button" aria-label="Show service links" aria-expanded="false" aria-controls="mobile-services" data-mobile-services-toggle><i aria-hidden="true"></i></button>
            </div>
            <div class="mobile-subnav__menu" id="mobile-services" hidden>
              {serviceItems.map((item) => <a href={item.href}>{item.label}<span>↗</span></a>)}
            </div>
          </div>
          {navItems.slice(1).map((item, index) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label} <span>0{index + 3}</span></a>)}
        </nav>
        <div class="mobile-menu__contact">
          <a href="tel:+16479812622">647 981 2622</a>
          <a href="mailto:norasupholstery@gmail.com">norasupholstery@gmail.com</a>
          <a href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>

    <main id="main-content" tabindex="-1"><slot /></main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="footer-mark"><img src="/legacy-logo-glass.webp" alt="Nora's Upholstery legacy needle and medical upholstery mark" loading="lazy" decoding="async" /></span>
            <p>The chair is our digital signature. The needle is our maker’s mark and a quiet reminder that every project is finished by hand.</p>
          </div>
          <div>
            <p class="footer-label">Explore</p>
            <a class="footer-priority-link" href="/contact">Contact Nora’s</a><a href="/services">Services</a><a href="/before-after">Our Work</a><a href="/testimonials">Client stories</a><a href="/service-areas">Service areas</a><a href="/about">Our Story</a>
          </div>
          <div>
            <p class="footer-label">Visit & contact</p>
            <p>Based in Richmond Hill, Ontario<br />Serving the GTA and Southern Ontario by request</p>
            <div class="footer-socials" aria-label="Contact and social links">
              <a href="tel:+16479812622" aria-label="Call Nora's Upholstery" title="Call"><span aria-hidden="true">☎</span></a>
              <a href="mailto:norasupholstery@gmail.com" aria-label="Email Nora's Upholstery" title="Email"><span aria-hidden="true">@</span></a>
              <a href={whatsappUrl} target="_blank" rel="noopener" aria-label="Message Nora's Upholstery on WhatsApp" title="WhatsApp"><img src="/icons/whatsapp.svg" alt="" loading="lazy" decoding="async" /></a>
              <a href={googleProfileUrl} target="_blank" rel="noopener" aria-label="Nora's Upholstery on Google Business" title="Google Business"><img src="/icons/google.svg" alt="" loading="lazy" decoding="async" /></a>
              <a href={instagramUrl} target="_blank" rel="noopener" aria-label="Nora's Upholstery on Instagram" title="Instagram"><img src="/icons/instagram.svg" alt="" loading="lazy" decoding="async" /></a>
              <a href={facebookUrl} target="_blank" rel="noopener" aria-label="Nora's Upholstery on Facebook" title="Facebook"><img src="/icons/facebook.svg" alt="" loading="lazy" decoding="async" /></a>
            </div>
          </div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Nora’s Upholstery</span><span class="footer-legal"><a href="/privacy-policy">Privacy</a><a href="/return-policy">Return policy</a></span><span>Precision craft across Southern Ontario</span></div>
      </div>
    </footer>

    <div class="mobile-actions" aria-label="Quick contact actions">
      <a href={travelContact.enabled ? whatsappUrl : 'tel:+16479812622'} target={travelContact.enabled ? '_blank' : undefined} rel={travelContact.enabled ? 'noopener' : undefined}><span>{travelContact.enabled ? 'WhatsApp' : 'Call'}</span><small>{travelContact.enabled ? 'Send a message' : 'Speak with us'}</small></a>
      <a href="mailto:norasupholstery@gmail.com"><span>Email</span><small>Send project details</small></a>
    </div>

    <script is:inline>
      const header = document.querySelector('[data-header]');
      const progress = document.querySelector('[data-scroll-progress]');
      const menu = document.querySelector('[data-mobile-menu]');
      const mobileActions = document.querySelector('.mobile-actions');
      const siteFooter = document.querySelector('.site-footer');
      const mainContent = document.querySelector('#main-content');
      const travelContact = document.querySelector('.travel-contact');
      const openButton = document.querySelector('[data-menu-open]');
      const closeButtons = document.querySelectorAll('[data-menu-close]');
      const closeButton = document.querySelector('.menu-close');
      const desktopSubnav = document.querySelector('[data-desktop-subnav]');
      const desktopServicesToggle = document.querySelector('[data-desktop-services-toggle]');
      const mobileServices = document.querySelector('#mobile-services');
      const mobileServicesToggle = document.querySelector('[data-mobile-services-toggle]');
      const inertLayers = [header, mainContent, siteFooter, mobileActions, travelContact].filter(Boolean);
      let returnFocus = openButton;

      const getMenuFocusable = () => {
        if (!menu) return [];
        return [...menu.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])')]
          .filter((element) => !element.closest('[hidden]') && element.getAttribute('aria-hidden') !== 'true');
      };

      const setPageInert = (inert) => {
        inertLayers.forEach((layer) => {
          layer.inert = inert;
        });
      };

      const setDesktopServices = (open) => {
        desktopSubnav?.classList.toggle('is-open', open);
        desktopServicesToggle?.setAttribute('aria-expanded', String(open));
      };
      const setMobileServices = (open) => {
        if (!mobileServices || !mobileServicesToggle) return;
        mobileServices.hidden = !open;
        mobileServicesToggle.setAttribute('aria-expanded', String(open));
      };

      const setMenu = (open) => {
        if (!menu || !openButton) return;
        if (open) returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : openButton;
        menu.hidden = !open;
        openButton.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-is-open', open);
        setPageInert(open);
        if (open) requestAnimationFrame(() => (closeButton ?? getMenuFocusable()[0])?.focus({ preventScroll: true }));
        else returnFocus?.focus({ preventScroll: true });
      };
      openButton?.addEventListener('click', () => setMenu(true));
      closeButtons.forEach((button) => button.addEventListener('click', () => setMenu(false)));
      window.matchMedia('(min-width: 821px)').addEventListener?.('change', (event) => {
        if (event.matches && !menu?.hidden) setMenu(false);
      });
      desktopServicesToggle?.addEventListener('click', () => setDesktopServices(desktopServicesToggle.getAttribute('aria-expanded') !== 'true'));
      mobileServicesToggle?.addEventListener('click', () => setMobileServices(mobileServicesToggle.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('click', (event) => { if (!desktopSubnav?.contains(event.target)) setDesktopServices(false); });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setDesktopServices(false);
          setMobileServices(false);
          if (!menu?.hidden) {
            event.preventDefault();
            setMenu(false);
          }
          return;
        }
        if (event.key !== 'Tab' || !menu || menu.hidden) return;

        const focusable = getMenuFocusable();
        if (!focusable.length) {
          event.preventDefault();
          return;
        }
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && (document.activeElement === first || !menu.contains(document.activeElement))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && (document.activeElement === last || !menu.contains(document.activeElement))) {
          event.preventDefault();
          first.focus();
        }
      });
      const updateScroll = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 24);
        const distance = document.documentElement.scrollHeight - window.innerHeight;
        if (progress) progress.style.transform = `scaleX(${distance > 0 ? window.scrollY / distance : 0})`;
      };
      updateScroll();
      window.addEventListener('scroll', updateScroll, { passive: true });

      if (mobileActions && siteFooter) {
        const footerObserver = new IntersectionObserver(([entry]) => {
          mobileActions.classList.toggle('is-over-footer', entry.isIntersecting);
          document.body.classList.toggle('mobile-actions-over-footer', entry.isIntersecting);
        }, { threshold: 0, rootMargin: '0px 0px 3.75rem 0px' });
        footerObserver.observe(siteFooter);
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        const revealTargets = document.querySelectorAll(
          '.section-heading, .services-page__header, .individual-service__hero, .individual-service__card, .service-image-card, .project-gallery > article, .content-card, .footer-grid > div'
        );
        revealTargets.forEach((element, index) => {
          element.classList.add('motion-reveal');
          element.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 70}ms`);
        });
        document.documentElement.classList.add('motion-ready');
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('motion-in');
            observer.unobserve(entry.target);
          });
        }, { threshold: .12, rootMargin: '0px 0px -5% 0px' });
        revealTargets.forEach((element) => revealObserver.observe(element));

        if (window.matchMedia('(pointer: fine)').matches) {
          document.querySelectorAll('.service-image-card, .individual-service__card').forEach((card) => {
            card.addEventListener('pointermove', (event) => {
              const bounds = card.getBoundingClientRect();
              const x = (event.clientX - bounds.left) / bounds.width - .5;
              const y = (event.clientY - bounds.top) / bounds.height - .5;
              card.style.setProperty('--tilt-x', `${x * 2.5}deg`);
              card.style.setProperty('--tilt-y', `${y * -2.5}deg`);
              card.style.setProperty('--shine-x', `${(x + .5) * 100}%`);
              card.style.setProperty('--shine-y', `${(y + .5) * 100}%`);
            });
            card.addEventListener('pointerleave', () => {
              card.style.setProperty('--tilt-x', '0deg');
              card.style.setProperty('--tilt-y', '0deg');
            });
          });
        }
      }
    </script>
  </body>
</html>
