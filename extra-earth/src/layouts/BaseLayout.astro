---
import '../styles/global.css';

const {
  title = "Nora's Upholstery",
  description = "Professional Upholstery for Clinics, Homes & Hospitality in the Greater Toronto Area.",
  seoImage = '/logo.png'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.png" />
    <title>{title}</title>

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={seoImage} />
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <!-- Ambient blobs -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute -top-28 -left-24 h-80 w-80 rounded-full blur-3xl"
           style="background: color-mix(in srgb, var(--navy) 30%, white 70%);"></div>
      <div class="absolute -top-32 right-0 h-96 w-96 rounded-full blur-3xl"
           style="background: color-mix(in srgb, var(--gold) 28%, white 72%);"></div>
    </div>

    <!-- Header -->
    <header class="sticky top-4 z-50">
      <div class="mx-auto max-w-7xl px-4">
        <div class="glass glass-nav px-4 py-2 flex items-center justify-between border hairline">
          <a href="/" class="flex items-center gap-3">
            <img src="/logo.png" alt="Nora's Upholstery logo" class="h-9 w-9 rounded-lg shadow-sm" />
            <span class="font-semibold">Nora's Upholstery</span>
          </a>

          <!-- Desktop nav -->
          <nav class="hidden md:flex items-center gap-6 relative">
            <a href="/">Home</a>
            <div class="relative group">
              <a href="/services" class="inline-flex items-center gap-1 px-2 py-1 hover:underline">
                <span>Services</span>
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd"/></svg>
              </a>
              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition absolute left-0 mt-2 w-64 glass border hairline p-2" role="menu">
                <a href="/services/medical"    class="block px-3 py-2 rounded-md hover:bg-black/5">Medical</a>
                <a href="/services/dental"     class="block px-3 py-2 rounded-md hover:bg-black/5">Dental</a>
                <a href="/services/home"       class="block px-3 py-2 rounded-md hover:bg-black/5">Home</a>
                <a href="/services/commercial" class="block px-3 py-2 rounded-md hover:bg-black/5">Commercial</a>
              </div>
            </div>
            <a href="/about">About</a>
            <a href="/testimonials">Testimonials</a>
            <a href="/before-after">Before/After</a>
            <a href="/contact" class="btn-primary">Get a Quote</a>
          </nav>

          <!-- Mobile -->
          <button id="mobileOpen" class="md:hidden btn-primary" aria-controls="mobileSheet" aria-expanded="false" aria-label="Open menu">Menu</button>
        </div>
      </div>
    </header>

    <!-- Mobile sheet -->
    <div id="mobileSheet" class="fixed inset-x-0 top-0 z-[60] translate-y-[-110%] opacity-0 transition duration-300">
      <div class="mx-auto max-w-7xl px-4 pt-4">
        <div class="glass border hairline p-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3"><img src="/logo.png" alt="" class="h-8 w-8 rounded-lg" /><span class="font-semibold">Menu</span></div>
            <button id="mobileClose" class="btn-gold" aria-label="Close menu">Close</button>
          </div>
          <nav class="mt-4 space-y-2">
            <a href="/" class="block px-3 py-2 rounded-md hover:bg-black/5">Home</a>
            <details class="rounded-md">
              <summary class="list-none cursor-pointer px-3 py-2 rounded-md hover:bg-black/5 flex items-center justify-between">
                <span>Services</span><span>▾</span>
              </summary>
              <div class="pl-3 pt-1 pb-2 space-y-1">
                <a href="/services"            class="block px-3 py-2 rounded-md hover:bg-black/5">All Services</a>
                <a href="/services/medical"    class="block px-3 py-2 rounded-md hover:bg-black/5">Medical</a>
                <a href="/services/dental"     class="block px-3 py-2 rounded-md hover:bg-black/5">Dental</a>
                <a href="/services/home"       class="block px-3 py-2 rounded-md hover:bg-black/5">Home</a>
                <a href="/services/commercial" class="block px-3 py-2 rounded-md hover:bg-black/5">Commercial</a>
              </div>
            </details>
            <a href="/about"         class="block px-3 py-2 rounded-md hover:bg-black/5">About</a>
            <a href="/testimonials"  class="block px-3 py-2 rounded-md hover:bg-black/5">Testimonials</a>
            <a href="/before-after"  class="block px-3 py-2 rounded-md hover:bg-black/5">Before/After</a>
            <a href="/contact"       class="block px-3 py-2 rounded-md hover:bg-black/5">Contact / Quote</a>
          </nav>
        </div>
      </div>
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20">
      <div class="mx-auto max-w-7xl px-4">
        <div class="glass p-6 md:p-8 grid md:grid-cols-3 gap-6 border hairline">
          <div>
            <div class="flex items-center gap-3 mb-3"><img src="/logo.png" class="h-9 w-9 rounded-lg" alt="Logo" /><div class="font-semibold">Nora's Upholstery</div></div>
            <p class="text-sm/6 opacity-90">Serving the GTA with professional upholstery for medical, fitness, hospitality and home furniture.</p>
          </div>
          <div>
            <h3 class="font-semibold mb-2">Contact</h3>
            <p class="text-sm"><a href="tel:+16479812622" class="hover:underline">647‑981‑2622</a></p>
            <p class="text-sm"><a href="mailto:shaida.nora@gmail.com" class="hover:underline">shaida.nora@gmail.com</a></p>
            <p class="text-sm opacity-90">Richmond Hill, Ontario</p>
          </div>
          <div>
            <h3 class="font-semibold mb-2">Areas We Cover</h3>
            <p class="text-sm opacity-90">Toronto, Richmond Hill, Vaughan, Markham, Mississauga, Oak Ridges, Newmarket, King</p>
          </div>
        </div>
        <div class="text-xs text-center py-4 opacity-70">© {new Date().getFullYear()} Nora's Upholstery</div>
      </div>
    </footer>

    <!-- Behaviors -->
    <script is:inline>
      // Header shadow
      const onScrollShadow = () => document.body.classList.toggle('is-scrolled', window.scrollY > 8);
      onScrollShadow(); window.addEventListener('scroll', onScrollShadow, { passive: true });

      // Mobile sheet
      const mOpen  = document.getElementById('mobileOpen');
      const mClose = document.getElementById('mobileClose');
      const sheet  = document.getElementById('mobileSheet');
      const setSheet = (s) => { sheet.style.transform = s ? 'translateY(0%)' : 'translateY(-110%)'; sheet.style.opacity = s ? '1' : '0'; mOpen?.setAttribute('aria-expanded', s); document.body.style.overflow = s ? 'hidden' : ''; };
      mOpen?.addEventListener('click', ()=> setSheet(true));
      mClose?.addEventListener('click', ()=> setSheet(false));
      document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') setSheet(false); });

      // ===== Blue + Gold headline color animation (robust, scroll-based) =====
      (function(){
        // Prefer an explicit #hero; fallback to first section.
        const hero = document.getElementById('hero') || document.querySelector('main section') || document.body;
        const targets = document.querySelectorAll('.ink, .gold-anim');
        if (!targets.length) return;

        const clamp = (v,min,max)=> Math.max(min, Math.min(max, v));

        function setProgress(){
          const r = hero.getBoundingClientRect();
          const win = window.innerHeight || document.documentElement.clientHeight;

          // Progress 0→1 from hero entering to passing ~60% of viewport
          const start = Math.min(win * 0.95, win - 1);
          const end   = win * 0.40;
          const pRaw  = (start - r.top) / Math.max(1, (start - end));
          const p     = clamp(pRaw, 0, 1);

          targets.forEach(el => {
            if (el.classList.contains('ink'))       el.style.setProperty('--inkp',  p.toFixed(3));
            if (el.classList.contains('gold-anim')) el.style.setProperty('--goldp', p.toFixed(3));
          });
        }
        setProgress();
        window.addEventListener('scroll', setProgress, { passive:true });
        window.addEventListener('resize', setProgress, { passive:true });
      })();
    </script>
  </body>
</html>