---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Privacy Policy | Nora's Upholstery";
const description = "How Nora's Upholstery collects, uses and protects information submitted through this website.";
---
<BaseLayout {title} {description}>
  <section class="policy-page shell">
    <header class="policy-page__header"><p class="eyebrow">Your information</p><h1>Privacy policy</h1><p>Last updated July 17, 2026</p></header>
    <article class="policy-page__content glass">
      <h2>Information we collect</h2>
      <p>When you call, email, or submit the estimate form, we may receive information you provide such as your name, email address, phone number, city, project details and photographs.</p>
      <h2>How we use it</h2>
      <p>We use this information to respond to your inquiry, prepare or discuss an estimate, coordinate service, and communicate about your project. We do not sell your personal information.</p>
      <h2>Website services</h2>
      <p>This website may be hosted or processed by service providers such as Cloudflare and may link to outside services including Google, Instagram and Facebook. Those providers handle information according to their own privacy policies.</p>
      <h2>Retention and protection</h2>
      <p>We keep project and contact information only as long as reasonably needed for customer service, business records, or legal requirements. Reasonable safeguards are used, but no website or electronic transmission can be guaranteed completely secure.</p>
      <h2>Your choices</h2>
      <p>You may ask to access, correct or delete personal information held by Nora’s Upholstery, subject to applicable legal and recordkeeping requirements.</p>
      <h2>Contact</h2>
      <p>Questions or privacy requests can be made by phone at <a href="tel:+16479812622">647 981 2622</a> or email at <a href="mailto:norasupholstery@gmail.com">norasupholstery@gmail.com</a>.</p>
    </article>
  </section>
</BaseLayout>
