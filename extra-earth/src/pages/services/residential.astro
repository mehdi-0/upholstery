---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Residential Furniture Upholstery — Nora's Upholstery";
const description = "Sofas, dining chairs, ottomans, cushions and more for homes across the GTA.";
const items = [
  "Sofas & sectionals",
  "Dining chairs & benches",
  "Ottomans & cushions",
  "Pickup & delivery available",
];
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-36 pb-14 space-y-6">
    <header class="space-y-2">
      <p class="kicker-gold">Services</p>
      <h1 class="text-3xl font-semibold">Residential</h1>
      <div class="gold-hr"></div>
    </header>

    <article class="glass p-6 border hairline">
      <ul class="list-disc pl-6 space-y-2">
        {items.map(i => <li>{i}</li>)}
      </ul>
      <a href="/contact" class="btn-primary mt-6 inline-flex">Get a Quote</a>
    </article>
  </section>
</BaseLayout>