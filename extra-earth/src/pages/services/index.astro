---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Services — Nora's Upholstery";
const description = "Medical, dental, residential and commercial upholstery for the GTA.";
const cards = [
  { href: '/services/medical',      name: 'Medical',      blurb: 'Exam & chiropractic tables, stools — cleanable, clinical vinyls.' },
  { href: '/services/dental',       name: 'Dental',       blurb: 'Dental chairs & stools, weekend rush available.' },
  { href: '/services/residential',  name: 'Residential',  blurb: 'Sofas, dining chairs, ottomans, cushions.' },
  { href: '/services/commercial',   name: 'Commercial',   blurb: 'Restaurant booths, hospitality seating, reception areas.' },
];
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-36 pb-14">
    <header class="space-y-2 mb-6">
      <p class="kicker-gold">What we do</p>
      <h1 class="text-3xl md:text-4xl font-semibold">Services</h1>
      <div class="gold-hr"></div>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {cards.map(c => (
        <a href={c.href} class="glass p-4 border hairline transition hover:-translate-y-0.5">
          <div class="font-semibold">{c.name}</div>
          <p class="text-sm opacity-90 mt-1">{c.blurb}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>