---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Dental Upholstery — Nora's Upholstery";
const description = "Dental chairs and stools with weekend rush options and precise patterning.";
const items = [
  "Dental chair re‑covering & foam repair",
  "Operator & assistant stools",
  "Weekend rush scheduling available",
  "Color‑matching to practice branding",
];
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-36 pb-14 space-y-6">
    <header class="space-y-2">
      <p class="kicker-gold">Services</p>
      <h1 class="text-3xl font-semibold">Dental</h1>
      <div class="gold-hr"></div>
    </header>

    <article class="glass p-6 border hairline">
      <ul class="list-disc pl-6 space-y-2">
        {items.map(i => <li>{i}</li>)}
      </ul>
      <a href="/contact" class="btn-primary mt-6 inline-flex">Get a Quote</a>
    </article>
  </section>
</BaseLayout>