---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "About — Nora's Upholstery";
const description = "Family‑run upholstery in Richmond Hill serving clinics, fitness, hospitality and homes across the GTA.";
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-36 pb-14">
    <h1 class="text-4xl font-semibold mb-6">About</h1>
    <div class="grid md:grid-cols-3 gap-8 items-start">
      <div class="md:col-span-2 space-y-4">
        <p>We specialize in medical & commercial upholstery where precision, durability and hygiene matter. Dental, chiropractic and fitness clients trust us to minimize downtime and match OEM fit.</p>
        <p>Typical turnaround is about a week. For dental, we offer weekend rush. Pickup & delivery available across the GTA.</p>
      </div>
      <aside class="glass p-6 border hairline">
        <h3 class="font-semibold mb-2">Quick facts</h3>
        <ul class="text-sm space-y-2">
          <li>• One‑week typical turnaround</li>
          <li>• Weekend rush for dental</li>
          <li>• Loaner chiropractic bed on request</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>