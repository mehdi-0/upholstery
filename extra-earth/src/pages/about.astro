---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
const title = "About Nora's Upholstery | Our Story";
const description = "Discover the story behind Nora’s Upholstery, a family-run Richmond Hill business with more than 40 years of upholstery experience.";
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-32 pb-10">
    <p class="kicker-gold mb-3">About Nora’s Upholstery</p>
    <h1 class="text-4xl font-semibold mb-5">Our Story</h1>
    <div class="grid md:grid-cols-3 gap-6 items-start">
      <div class="md:col-span-2 space-y-4">
        <p>For more than 40 years, Nora’s Upholstery has brought careful, hands-on craftsmanship to pieces used every day. What began with traditional upholstery experience now serves dental and medical practices, homes, restaurants, gyms and other businesses across the GTA and Southern Ontario.</p>
        <p>We approach every project by listening first, understanding how the piece is used and selecting a finish that respects both its purpose and the people who rely on it. Clinical work remains a specialty, supported by the same attention to fit, durability and finish that we bring to residential and commercial furniture.</p>
        <p>Please call or email before visiting so we can arrange a time and prepare for your project.</p>
      </div>
      <aside class="glass p-6 border hairline">
        <h3 class="font-semibold mb-2">Quick facts</h3>
        <ul class="text-sm space-y-2">
          <li>• More than 40 years of experience</li>
          <li>• Weekend rush for dental</li>
          <li>• Pickup and delivery across the GTA</li>
          <li>• Loaner chiropractic bed on request</li>
        </ul>
      </aside>
    </div>
    <PhotoStrip heading="Inside the craft" photos={[
      { src: '/images/about-workshop.webp', label: 'In the workshop', note: 'Hands cutting, sewing or fitting upholstery', alt: "Upholstery work underway in Nora's workshop" },
      { src: '/images/about-materials.webp', label: 'Materials & details', note: 'Vinyl, fabric, thread or careful seam work', alt: 'Upholstery materials and stitching details' },
    ]} />
  </section>
</BaseLayout>
