---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Nora's Upholstery — Precision Upholstery for Clinics, Fitness & Hospitality";
const description = "Dental chairs, chiropractic tables, gym pads, restaurant booths and fine home furniture. Pickup & delivery across the GTA.";

const stories = [
  {
    img: '/after-chiro.jpg',
    who: 'Dr. David Song',
    quote: 'Awesome rates and beautiful workmanship for my chiropractic table. They also replaced some missing screws and cleaned up some nasty rust that I had going on with the table. Great communication as well.'
  },
  {
    img: '/after-chiro.jpg',
    who: 'Chiropractic Clinic — Toronto',
    quote: 'Loaner bed kept us open; finish is flawless. Turnaround was faster than expected.'
  },
  {
    img: '/before-chiro.jpg',
    who: 'Dental Office — Vaughan',
    quote: 'Chairs recovered over a weekend. Seam alignment and color match are perfect.'
  },
  {
    img: '/after-chiro.jpg',
    who: 'Fitness Studio — Richmond Hill',
    quote: 'Our benches feel brand new. Durable, easy‑to‑clean vinyl and tight patterning.'
  },
];
---
<BaseLayout {title} {description}>

  <!-- Hero (reduced height so stories start sooner) -->
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-32 pb-10 min-h-[90vh] grid md:grid-cols-[1.2fr_.8fr] gap-10 items-center">
    <div class="space-y-6">
      <h1 class="text-5xl md:text-6xl font-semibold leading-tight tracking-tight">
        Upholstery engineered for <span class="ink">clinical use</span> and <span class="ink">high traffic</span>
      </h1>
      <p class="text-lg opacity-90">
        Medical‑grade vinyls, precision patterning, foam refurbishment and on‑time turnarounds.
        Weekend rush available for <span class="gold-strong">dental</span>. We rebuild
        <span class="gold-strong">foam</span>, match <span class="gold-strong">patterns</span>, and meet
        <span class="gold-strong">tight deadlines</span>.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary">Get a Quote</a>
        <a href="/before-after" class="btn-gold">Before / After</a>
      </div>

      <div class="flex flex-wrap gap-2 pt-2">
        <span class="glass px-3 py-1 text-sm border hairline">Dental & Medical</span>
        <span class="glass px-3 py-1 text-sm border hairline">Chiropractic</span>
        <span class="glass px-3 py-1 text-sm border hairline">Fitness Clubs</span>
        <span class="glass px-3 py-1 text-sm border hairline">Hospitality</span>
        <span class="glass px-3 py-1 text-sm border hairline">Residential</span>
      </div>
    </div>

    <aside class="glass p-6 md:p-8 border hairline">
      <div class="flex items-center gap-3 mb-4">
        <img src="/logo.png" alt="Nora's Upholstery" class="h-10 w-10 rounded-xl shadow" />
        <div>
          <div class="font-medium">Precision Upholstery</div>
          <div class="text-xs opacity-70">Antibacterial vinyl • Foam repair • Pattern match</div>
        </div>
      </div>
      <ul class="text-sm space-y-2 mb-6">
        <li>• Dental chairs & stools (rush available)</li>
        <li>• Chiropractic & exam tables (loaner bed on request)</li>
        <li>• Fitness equipment pads (commercial vinyls)</li>
        <li>• Restaurant booths & residential furniture</li>
      </ul>
      <a href="/contact" class="btn-primary w-full justify-center">Start Your Estimate</a>
    </aside>
  </section>

  <!-- ===== Client Stories: fixed-center quote; images move/alternate underneath ===== -->
  <section class="stories mx-auto max-w-7xl px-4 py-10">
    <!-- Sticky, centered quotes layer (overlaps images) -->
    <div class="stories-viewport">
      <div class="quote-stack">
        {stories.map((s, i) => (
          <blockquote id={`quote-${i}`} class="quote-card">
            <p class="text-xl md:text-2xl italic">“{s.quote}”</p>
            <footer class="mt-3 text-sm opacity-80">— {s.who}</footer>
          </blockquote>
        ))}
      </div>
    </div>

    <!-- Scrolling image track (under the quotes) -->
    <div class="stories-track">
      {stories.map((s, i) => (
        <section id={`frame-${i}`} class={`frame ${i % 2 === 1 ? 'frame--even' : ''}`}>
          <div class="frame-inner">
            <div class="pic-wrap" id={`pic-${i}`}>
              <img src={s.img} alt={s.who} class="pic" />
            </div>
            <div class="spacer"></div>
          </div>
        </section>
      ))}
    </div>
  </section>

  <!-- Scrollytelling logic: overlap, earlier start, stronger nudge -->
  <script is:inline>
    const frames = Array.from(document.querySelectorAll('.frame'));
    const quotes = frames.map((_, i) => document.getElementById(`quote-${i}`));
    const pics   = frames.map((_, i) => document.getElementById(`pic-${i}`));

    const vh = () => window.innerHeight || document.documentElement.clientHeight;
    const clamp = (v,min,max)=> Math.max(min, Math.min(max, v));
    const ease = (t)=> t<.5 ? 2*t*t : 1 - Math.pow(-2*t+2,2)/2;

    function update(){
      const mid = vh()*0.5; // viewport center
      let bestIdx = 0, bestScore = -Infinity;

      frames.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        const center = r.top + r.height/2;
        const dist = Math.abs(center - mid);
        const range = Math.max(1, r.height*0.6); // active zone width
        let score = 1 - (dist / range);
        score = clamp(score, 0, 1);
        if (score > bestScore) { bestScore = score; bestIdx = i; }

        // Local progress [-1..1] for parallax
        const local = clamp((mid - r.top) / Math.max(1, r.height), 0, 1) * 2 - 1;
        const shiftY = local * 30 * score; // stronger vertical motion
        pics[i].style.setProperty('--parallax', `${-shiftY.toFixed(1)}px`);
      });

      quotes.forEach((q, i) => {
        const a = i === bestIdx ? ease(bestScore) : 0;
        q.style.opacity = a.toFixed(3);
        q.style.transform = `translateY(${(1-a)*10}px)`;
      });
    }

    let ticking=false;
    function onScroll(){ if(!ticking){ requestAnimationFrame(()=>{ ticking=false; update(); }); ticking=true; } }
    update();
    window.addEventListener('scroll', onScroll, { passive:true });
    window.addEventListener('resize', update, { passive:true });
  </script>
</BaseLayout>