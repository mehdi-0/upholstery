---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Contact — Nora's Upholstery";
const description = "Request a free estimate. Send us photos of your items and any deadlines.";
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-36 pb-14">
    <h1 class="text-3xl font-semibold mb-6">Contact</h1>
    <p class="opacity-90">Phone: <a href="tel:+16479812622" class="underline">647‑981‑2622</a> • Email: <a href="mailto:shaida.nora@gmail.com" class="underline">shaida.nora@gmail.com</a></p>

    <div class="glass p-6 md:p-8 border hairline mt-8">
      <h2 class="text-xl font-semibold mb-4">Get a Quote</h2>
      <!-- When deploying on Cloudflare Pages: connect this to Formspree/Basin -->
      <form method="POST" class="grid gap-4 md:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Name</span>
          <input name="name" required class="mt-1 w-full rounded-xl border p-3 bg-white/70" />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input type="email" name="email" required class="mt-1 w-full rounded-xl border p-3 bg-white/70" />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Phone</span>
          <input name="phone" class="mt-1 w-full rounded-xl border p-3 bg-white/70" />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Item type & quantity</span>
          <input name="items" class="mt-1 w-full rounded-xl border p-3 bg-white/70" />
        </label>
        <label class="block md:col-span-2">
          <span class="text-sm font-medium">Message / deadlines</span>
          <textarea name="message" rows="4" class="mt-1 w-full rounded-xl border p-3 bg-white/70"></textarea>
        </label>
        <div class="md:col-span-2">
          <button class="btn-primary" type="submit">Send</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>