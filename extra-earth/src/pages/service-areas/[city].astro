---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serviceAreas, type ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({ params: { city: area.slug }, props: { area } }));
}

const { area } = Astro.props as { area: ServiceArea };
const canonicalPath = `/service-areas/${area.slug}/`;
const otherAreas = serviceAreas.filter((item) => item.slug !== area.slug);
const faq = [
  {
    question: `What upholstery services are available in ${area.name}?`,
    answer: 'Nora’s Upholstery works on dental and medical seating, chiropractic tables, residential furniture, restaurant and hospitality seating, fitness equipment and other commercial seating.',
  },
  {
    question: `Do you offer pickup and delivery in ${area.name}?`,
    answer: 'Pickup and delivery may be available. We confirm logistics after reviewing the location, access, number of pieces, project type and schedule.',
  },
  {
    question: 'What should I send for an estimate?',
    answer: 'Send clear photos of the complete piece and damaged areas, the quantity, your city or postal code, desired timing and any material or colour preferences.',
  },
];
---
<BaseLayout title={area.title} description={area.description}>
  <header class="location-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/service-areas">Service areas</a><span aria-hidden="true">/</span><span>{area.name}</span>
      </nav>
      <p class="eyebrow">{area.region}</p>
      <h1>Upholstery in<br /><em>{area.name}.</em></h1>
      <p class="location-intro">{area.intro}</p>
      <div class="location-actions">
        <a class="button button--dark" href="tel:+16479812622">Call 647 981 2622</a>
        <a class="text-link" href="mailto:norasupholstery@gmail.com">Email project photos <span>↗</span></a>
      </div>
    </div>
  </header>

  <section class="content-section location-content">
    <div class="shell">
      <div class="section-heading section-heading--compact">
        <div><p class="eyebrow">Services for your space</p><h2 class="display-heading">Specialized work,<br /><em>planned locally.</em></h2></div>
        <p>{area.localNote}</p>
      </div>
      <div class="location-service-grid">
        {area.popularServices.map((service, index) => (
          <a class="glass individual-service__card" href={service.href}>
            <span>0{index + 1}</span><h2>{service.title}</h2><p>{service.text}</p><strong>Explore service <i>↗</i></strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section location-detail-section">
    <div class="shell location-detail-grid">
      <div class="glass location-coverage">
        <p class="eyebrow">Area coverage</p>
        <h2>{area.name} and nearby communities</h2>
        <ul>{area.coverage.map((place) => <li>{place}</li>)}</ul>
        <p>Not seeing your neighbourhood? Service is based on project fit, not a rigid boundary. Call with your location and project details.</p>
      </div>
      <div class="location-faq">
        <p class="eyebrow">Before you contact us</p>
        <h2>Common questions</h2>
        {faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="content-section location-nearby">
    <div class="shell">
      <p class="eyebrow">Other regular service areas</p>
      <div class="location-links">
        {otherAreas.map((item) => <a href={`/service-areas/${item.slug}/`}>{item.name}<span>↗</span></a>)}
        <a href="/service-areas">View all service areas<span>↗</span></a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'LocalBusiness',
        name: "Nora's Upholstery",
        telephone: '+1-647-981-2622',
        email: 'norasupholstery@gmail.com',
        url: canonicalPath,
        areaServed: { '@type': 'City', name: area.name },
        address: { '@type': 'PostalAddress', addressLocality: 'Richmond Hill', addressRegion: 'ON', addressCountry: 'CA' },
      },
      {
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
          { '@type': 'ListItem', position: 2, name: 'Service areas', item: '/service-areas/' },
          { '@type': 'ListItem', position: 3, name: area.name, item: canonicalPath },
        ],
      },
    ],
  })} />
</BaseLayout>

<style>
  .location-hero { padding: 10.5rem 0 5rem; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: 2.5rem; color: rgba(8,30,39,.52); font-size: .68rem; }
  .breadcrumbs a:hover { color: var(--saddle); }
  .location-hero h1 { max-width: 950px; margin: .7rem 0 1.7rem; font-family: var(--serif); font-size: clamp(4rem, 9vw, 8.5rem); font-weight: 400; letter-spacing: -.05em; line-height: .82; }
  .location-hero h1 em, .display-heading em { color: var(--saddle); font-weight: 400; }
  .location-intro { max-width: 680px; color: rgba(8,30,39,.7); font-size: clamp(1rem, 1.5vw, 1.18rem); }
  .location-actions { display: flex; align-items: center; gap: 1.4rem; margin-top: 2rem; }
  .location-service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .9rem; }
  .location-service-grid .individual-service__card { min-height: 320px; }
  .location-service-grid strong { display: flex; justify-content: space-between; margin-top: auto; padding-top: 1.4rem; border-top: 1px solid var(--line); font-size: .7rem; }
  .location-service-grid i { font-style: normal; }
  .location-detail-section { padding-top: 0; }
  .location-detail-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 1rem; }
  .location-coverage, .location-faq { padding: clamp(1.5rem, 4vw, 3rem); }
  .location-coverage h2, .location-faq h2 { margin: .7rem 0 1.5rem; font-family: var(--serif); font-size: clamp(2.3rem, 4vw, 4rem); font-weight: 400; line-height: .95; }
  .location-coverage ul { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; }
  .location-coverage li { padding: .5rem .75rem; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.4); font-size: .7rem; }
  .location-coverage > p:last-child { margin-top: 2rem; color: rgba(8,30,39,.62); font-size: .8rem; }
  .location-faq details { border-top: 1px solid var(--line); padding: 1rem 0; }
  .location-faq details:last-child { border-bottom: 1px solid var(--line); }
  .location-faq summary { cursor: pointer; font-weight: 600; }
  .location-faq details p { max-width: 620px; margin: .8rem 0 0; color: rgba(8,30,39,.65); font-size: .8rem; }
  .location-nearby { padding-top: 0; }
  .location-links { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .location-links a { display: flex; justify-content: space-between; padding: 1.2rem 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 820px) {
    .location-hero { padding: 8.5rem 0 3.5rem; }
    .location-hero h1 { font-size: clamp(3.6rem, 17vw, 5.7rem); }
    .location-actions, .location-service-grid, .location-detail-grid, .location-links { display: grid; grid-template-columns: 1fr; }
    .location-actions .button { width: 100%; }
    .location-service-grid .individual-service__card { min-height: 280px; }
  }
</style>
