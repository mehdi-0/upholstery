---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Before & After Projects | Nora's Upholstery";
const description = "Compare upholstery restorations for clinical, commercial and residential furniture across the GTA.";
const galleryPhotos = [
  { src: '/images/gallery-clinical-detail.webp', label: 'Clinical detail', note: 'Detailed view of seams, contours or vinyl suitable for medical settings', alt: 'Detailed view of completed clinical upholstery' },
  { src: '/images/gallery-dental.webp', label: 'Dental', note: 'Completed patient chair, dentist chair or dental assistant stool', alt: 'Completed dental chair upholstery project' },
  { src: '/images/gallery-chiropractic.webp', label: 'Chiropractic', note: 'Finished segmented adjustment table', alt: 'Completed chiropractic table upholstery project' },
  { src: '/images/gallery-residential.webp', label: 'Residential', note: 'Sofa, armchair, dining seating or cushions', alt: 'Completed residential upholstery project' },
  { src: '/images/gallery-restaurant.webp', label: 'Restaurant', note: 'Booth, banquette, stool or dining seating', alt: 'Completed restaurant upholstery project' },
  { src: '/images/gallery-specialty.webp', label: 'Commercial & specialty', note: 'Fitness, bowling, reception or venue seating', alt: 'Completed specialty commercial upholstery project' },
];
---
<BaseLayout {title} {description}>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Selected transformations</p>
      <h1>See what careful<br /><em>restoration changes.</em></h1>
      <p>Drag each divider or use its keyboard-accessible slider to inspect the finish. Additional projects can be added by duplicating one project block.</p>
    </div>
  </header>

  <section class="content-section">
    <div class="shell project-gallery">
      <article>
        <div class="section-heading section-heading--compact">
          <div><p class="eyebrow">01 · Clinical</p><h2 class="display-heading">Chiropractic<br /><em>table renewal.</em></h2></div>
          <p>Medical-grade vinyl, refreshed foam and a clean pattern fit completed over a weekend.</p>
        </div>
        <div class="project-stage">
          <div class="compare" data-compare style="--position: 52%">
            <img src="/before-chiro.jpg" alt="Chiropractic table before restoration" />
            <div class="compare__after"><img src="/after-chiro.jpg" alt="Chiropractic table after restoration" /></div>
            <span class="compare__label compare__label--before">Before</span><span class="compare__label compare__label--after">After</span>
            <input type="range" min="0" max="100" value="52" aria-label="Compare the chiropractic table before and after" data-compare-range />
            <div class="compare__handle" aria-hidden="true"><span>↔</span></div>
          </div>
        </div>
      </article>

      <article>
        <div class="section-heading section-heading--compact">
          <div><p class="eyebrow">02 · Residential placeholder</p><h2 class="display-heading">Dining chairs,<br /><em>made personal.</em></h2></div>
          <p>Reserved for a matching before/after pair photographed from the same camera position.</p>
        </div>
        <!--
          BEFORE/AFTER PAIR NEEDED: RESIDENTIAL
          Subject: dining chair, armchair or ottoman before and after restoration.
          Format: two WebP/AVIF files, minimum 1600 × 1200 px each.
          Critical: identical camera angle, crop and lighting for both photographs.
          Fixed filenames: /images/dining-chair-before.webp and /images/dining-chair-after.webp
          Uploading both files is enough; they appear over the fallbacks automatically.
        -->
        <div class="project-stage">
          <div class="compare compare--placeholder" data-compare style="--position: 46%">
            <div class="comparison-placeholder comparison-placeholder--before"><span>Residential before photo</span></div>
            <img class="replacement-photo" src="/images/dining-chair-before.webp" alt="Residential furniture before upholstery restoration" onerror="this.hidden=true" />
            <div class="compare__after">
              <div class="comparison-placeholder comparison-placeholder--after"><span>Residential after photo</span></div>
              <img class="replacement-photo" src="/images/dining-chair-after.webp" alt="Residential furniture after upholstery restoration" onerror="this.hidden=true" />
            </div>
            <span class="compare__label compare__label--before">Before</span><span class="compare__label compare__label--after">After</span>
            <input type="range" min="0" max="100" value="46" aria-label="Preview residential before and after slider" data-compare-range />
            <div class="compare__handle" aria-hidden="true"><span>↔</span></div>
          </div>
        </div>
      </article>

      <article>
        <div class="section-heading section-heading--compact">
          <div><p class="eyebrow">03 · Commercial placeholder</p><h2 class="display-heading">High traffic,<br /><em>restored beautifully.</em></h2></div>
          <p>Reserved for a restaurant booth, reception seat or fitness pad transformation.</p>
        </div>
        <!--
          BEFORE/AFTER PAIR NEEDED: COMMERCIAL
          Subject: restaurant booth, reception seating or gym pad before and after.
          Format: two WebP/AVIF files, minimum 1800 × 1200 px each.
          Critical: identical camera angle and crop; keep the repaired seam visible.
          Fixed filenames: /images/commercial-before.webp and /images/commercial-after.webp
          Uploading both files is enough; they appear over the fallbacks automatically.
        -->
        <div class="project-stage">
          <div class="compare compare--placeholder compare--commercial" data-compare style="--position: 58%">
            <div class="comparison-placeholder comparison-placeholder--before"><span>Commercial before photo</span></div>
            <img class="replacement-photo" src="/images/commercial-before.webp" alt="Commercial seating before upholstery restoration" onerror="this.hidden=true" />
            <div class="compare__after">
              <div class="comparison-placeholder comparison-placeholder--after"><span>Commercial after photo</span></div>
              <img class="replacement-photo" src="/images/commercial-after.webp" alt="Commercial seating after upholstery restoration" onerror="this.hidden=true" />
            </div>
            <span class="compare__label compare__label--before">Before</span><span class="compare__label compare__label--after">After</span>
            <input type="range" min="0" max="100" value="58" aria-label="Preview commercial before and after slider" data-compare-range />
            <div class="compare__handle" aria-hidden="true"><span>↔</span></div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="work-carousel-section">
    <div class="shell">
      <div class="section-heading section-heading--compact">
        <div><p class="eyebrow">More completed work</p><h2 class="display-heading">A rotating look<br /><em>through the portfolio.</em></h2></div>
        <p>Add photos using the fixed filenames in the image guide. Until then, each position keeps its designed placeholder.</p>
      </div>
      <div class="work-carousel" data-work-carousel>
        <div class="work-carousel__viewport" data-carousel-viewport tabindex="0" aria-label="Completed upholstery photo gallery">
          <div class="work-carousel__track">
            {galleryPhotos.map((photo, index) => (
              <figure class="work-carousel__slide" data-carousel-slide>
                <div class="work-carousel__fallback"><span>0{index + 1} · {photo.label}</span><small>{photo.note}</small></div>
                <img src={photo.src} alt={photo.alt} loading="lazy" onerror="this.hidden=true" />
                <figcaption>{photo.label}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <div class="work-carousel__controls">
          <button type="button" data-carousel-prev aria-label="Show previous gallery image">←</button>
          <span data-carousel-status aria-live="polite">1 / {galleryPhotos.length}</span>
          <button type="button" data-carousel-next aria-label="Show next gallery image">→</button>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-compare]').forEach((comparison) => {
      const range = comparison.querySelector('[data-compare-range]');
      range?.addEventListener('input', () => comparison.style.setProperty('--position', `${range.value}%`));
    });

    const carousel = document.querySelector('[data-work-carousel]');
    const viewport = carousel?.querySelector('[data-carousel-viewport]');
    const slides = Array.from(carousel?.querySelectorAll('[data-carousel-slide]') || []);
    const status = carousel?.querySelector('[data-carousel-status]');
    let activeSlide = 0;
    let autoRotate;

    const showSlide = (index) => {
      if (!viewport || !slides.length) return;
      activeSlide = (index + slides.length) % slides.length;
      viewport.scrollTo({ left: slides[activeSlide].offsetLeft, behavior: 'smooth' });
      if (status) status.textContent = `${activeSlide + 1} / ${slides.length}`;
    };
    const startRotation = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      window.clearInterval(autoRotate);
      autoRotate = window.setInterval(() => showSlide(activeSlide + 1), 5000);
    };
    carousel?.querySelector('[data-carousel-prev]')?.addEventListener('click', () => { showSlide(activeSlide - 1); startRotation(); });
    carousel?.querySelector('[data-carousel-next]')?.addEventListener('click', () => { showSlide(activeSlide + 1); startRotation(); });
    carousel?.addEventListener('mouseenter', () => window.clearInterval(autoRotate));
    carousel?.addEventListener('mouseleave', startRotation);
    carousel?.addEventListener('focusin', () => window.clearInterval(autoRotate));
    carousel?.addEventListener('focusout', startRotation);
    viewport?.addEventListener('scrollend', () => {
      if (!slides.length) return;
      activeSlide = slides.reduce((closest, slide, index) => Math.abs(slide.offsetLeft - viewport.scrollLeft) < Math.abs(slides[closest].offsetLeft - viewport.scrollLeft) ? index : closest, 0);
      if (status) status.textContent = `${activeSlide + 1} / ${slides.length}`;
    });
    startRotation();
  </script>
</BaseLayout>

<style>
  .page-hero h1 em { color: var(--saddle); font-weight: 400; }
  .project-gallery { gap: 4rem; }
  .project-gallery .project-stage { width: min(100%, 900px); margin-inline: auto; }
  .project-gallery article:nth-child(even) .project-stage { margin-inline: auto; }
  .project-gallery .compare { height: clamp(340px, 40vw, 520px); }
  .comparison-placeholder { position: absolute; inset: 0; display: grid; width: min(100vw - 2rem, 1240px); height: 100%; place-items: center; color: rgba(255,255,255,.64); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; background: radial-gradient(circle at 70% 25%, rgba(183,138,71,.28), transparent 22%), repeating-linear-gradient(98deg, rgba(255,255,255,.06) 0 1px, transparent 1px 6px), linear-gradient(135deg,#263c42,#101d21); }
  .comparison-placeholder--after { background: radial-gradient(circle at 35% 28%, rgba(238,230,216,.26), transparent 23%), repeating-linear-gradient(82deg, rgba(255,255,255,.1) 0 1px, transparent 1px 5px), linear-gradient(135deg,#9a7650,#173b48); }
  .compare--commercial .comparison-placeholder--before { background-color: #3b2922; }
  .compare--commercial .comparison-placeholder--after { background: linear-gradient(145deg,#102f3d,#5d4937); }
  .replacement-photo { z-index: 1; }
  .work-carousel-section { padding: 1rem 0 clamp(5rem, 9vw, 8rem); }
  .work-carousel { position: relative; }
  .work-carousel__viewport { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .work-carousel__viewport::-webkit-scrollbar { display: none; }
  .work-carousel__track { display: flex; gap: .8rem; }
  .work-carousel__slide { position: relative; flex: 0 0 min(72vw, 760px); height: clamp(340px, 42vw, 520px); margin: 0; border: 1px solid rgba(255,255,255,.56); border-radius: 1.5rem; background: var(--ink); box-shadow: 0 24px 55px rgba(5,21,27,.13); overflow: hidden; scroll-snap-align: center; }
  .work-carousel__slide::after { content: ''; position: absolute; z-index: 2; inset: auto 0 0; height: 44%; pointer-events: none; background: linear-gradient(transparent, rgba(3,17,23,.72)); }
  .work-carousel__fallback { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: end; padding: 1.5rem; color: rgba(255,255,255,.76); background: radial-gradient(circle at 72% 22%, rgba(183,138,71,.3), transparent 25%), repeating-linear-gradient(98deg, rgba(255,255,255,.06) 0 1px, transparent 1px 7px), linear-gradient(145deg,#173e4b,#0a2029); }
  .work-carousel__fallback span { font-family: var(--serif); font-size: 2rem; }
  .work-carousel__fallback small { color: rgba(255,255,255,.48); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; }
  .work-carousel__slide img { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .work-carousel__slide figcaption { position: absolute; z-index: 3; right: 1.5rem; bottom: 1.35rem; color: #fff; font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .work-carousel__controls { display: flex; align-items: center; justify-content: end; gap: .8rem; margin-top: 1rem; }
  .work-carousel__controls button { display: grid; width: 2.8rem; height: 2.8rem; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: rgba(255,255,255,.5); cursor: pointer; }
  .work-carousel__controls span { min-width: 3.2rem; color: rgba(8,30,39,.55); font-size: .68rem; text-align: center; }
  @media (max-width: 820px) {
    .project-gallery .compare { height: min(56svh, 480px); min-height: 350px; }
    .work-carousel__slide { flex-basis: 86vw; height: min(62svh, 470px); }
    .work-carousel__controls { justify-content: center; }
  }
</style>
