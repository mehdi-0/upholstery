---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Service Areas — Nora's Upholstery (GTA & 100 km Radius)";
const description = "Core service areas across the GTA plus a wider 100 km radius around Toronto. Contact us for rush jobs or special trips.";

const coreAreas = [
  "Toronto", "North York", "York Region", "Richmond Hill",
  "Vaughan", "Markham", "Scarborough", "Mississauga"
];

const widerAreas = [
  "Brampton", "Oakville", "Burlington", "Hamilton",
  "Aurora", "Newmarket", "King City", "Pickering",
  "Ajax", "Whitby", "Oshawa", "Milton"
];
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-5xl px-4 pt-28 md:pt-32 pb-12">
    <h1 class="text-4xl md:text-5xl font-semibold mb-3">Service Areas</h1>
    <p class="opacity-90 mb-8">We’re based in the GTA and regularly serve the locations below. We also take projects across a wider radius—reach out to confirm pickup/delivery windows.</p>

    <div class="glass border hairline p-5 mb-8">
      <h2 class="text-xl font-semibold mb-2">Core Areas</h2>
      <div class="areas-grid">
        {coreAreas.map((a) => <div class="area-chip"><span class="area-pin"></span>{a}</div>)}
      </div>
    </div>

    <div class="glass border hairline p-5">
      <h2 class="text-xl font-semibold mb-2">Within ~100 km of Toronto</h2>
      <p class="text-sm opacity-85 mb-3">Typical weekly runs. Occasional special trips are available by request.</p>
      <div class="areas-grid">
        {widerAreas.map((a) => <div class="area-chip"><span class="area-pin"></span>{a}</div>)}
      </div>
    </div>
  </section>

  <!-- SEO: express a service radius (GeoCircle) around Toronto -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Nora's Upholstery",
    "url": "https://YOUR-DOMAIN/",
    "areaServed": {
      "@type": "GeoCircle",
      "geoMidpoint": {
        "@type": "GeoCoordinates",
        "latitude": 43.6532,
        "longitude": -79.3832
      },
      "geoRadius": 100000
    },
    "servesCuisine": "Upholstery",
    "address": { "@type": "PostalAddress", "addressLocality": "Toronto", "addressRegion": "ON", "addressCountry": "CA" }
  }
  </script>
</BaseLayout>