---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Testimonials — Nora's Upholstery";
const description = "What our clients say about our upholstery work.";
const quotes = [
  { name: "Dental Clinic, Vaughan", text: "They re‑covered three operator chairs over a weekend—perfect fit and finish." },
  { name: "Fitness Studio, Toronto", text: "Our bench pads look brand new. Durable vinyl and fast turnaround." },
  { name: "Restaurant Owner, Markham", text: "Booth seating was installed after hours—no disruption, great workmanship." },
];
---
<BaseLayout {title} {description}>
  <section class="mx-auto max-w-7xl px-4 pt-28 md:pt-36 pb-14">
    <h1 class="text-3xl font-semibold mb-6">Customer Testimonials</h1>
    <div class="grid md:grid-cols-3 gap-6">
      {quotes.map(q => (
        <blockquote class="glass p-6 border hairline">
          <p class="italic opacity-90">“{q.text}”</p>
          <footer class="mt-3 text-sm opacity-80">— {q.name}</footer>
        </blockquote>
      ))}
    </div>
  </section>
</BaseLayout>